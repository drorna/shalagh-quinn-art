---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  bare?: boolean;
}

const {
  title = "Shalagh Quinn",
  description = "",
  ogImage = "/og-image.jpg",
  bare = false,
} = Astro.props;

const siteUrl = "https://shalagh.com";
const canonicalUrl = new URL(Astro.url.pathname, siteUrl).toString();
const absoluteOgImage = new URL(ogImage, siteUrl).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=390" />
    {description && <meta name="description" content={description} />}
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#f4f3ed" />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Shalagh Quinn" />
    <meta property="og:title" content={title} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={absoluteOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Artwork by Shalagh Quinn" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:image" content={absoluteOgImage} />

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Shalagh Quinn",
      "url": siteUrl,
      "image": absoluteOgImage,
      "sameAs": ["https://instagram.com/shalagh"],
    })} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;700&family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500;1,600&family=Inter:ital,wght@0,300;0,400;0,500;0,600;1,300;1,400;1,500&display=swap"
    />

    <title>{title}</title>
  </head>

  <body class:list={{ "is-bare": bare }}>
    {!bare && <Header />}
    <main id="main">
      <slot />
      <!-- Page-extras: ~80 vh of empty real estate at the bottom of every
           page so drorna can use the editor's "+ text" floating boxes to
           extend any page without hitting a hard scroll bottom. The
           boxes anchor to body absolutely; this section's only job is to
           grow the page's scroll height to give them room to land. -->
      <div class="page-extras" aria-hidden="true"></div>
    </main>
    {!bare && <Footer />}

    <style>
      .page-extras {
        width: 100%;
        min-height: 80vh;
      }
    </style>

    <script>
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -8% 0px" }
      );

      document.querySelectorAll(".reveal").forEach((el) => observer.observe(el));
    </script>

    <!-- Site-wide editors: every page using BaseLayout becomes editable.
         No per-page wiring needed for new pages. -->
    <script>
      import { initTextEditor } from "../scripts/text-editor";
      import { initImageEditor } from "../scripts/image-editor";
      import { initEditNav } from "../scripts/edit-nav";
      import { initLightbox } from "../scripts/lightbox";
      initTextEditor();
      initImageEditor();
      initEditNav();
      initLightbox();
    </script>
  </body>
</html>
