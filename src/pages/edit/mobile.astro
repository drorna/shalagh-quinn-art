---
/**
 * Mobile-edit shell.
 *
 * A separate, self-contained editor for the @mobile variant — distinct
 * URL, distinct chrome, no overlap with the desktop editor. The site
 * renders inside a 390px-wide iframe so the inner page sees a true
 * mobile viewport: matchMedia returns mobile, @media (max-width:767px)
 * activates, vw units compute against 390, and saved edits go straight
 * to @mobile rows.
 *
 * The page being edited skips its own floating edit-nav when it
 * detects it's inside an iframe (see edit-nav.ts), so the only chrome
 * visible is this outer shell. No window-in-window nesting.
 *
 * URL: `/edit/mobile/?path=/about/&edit=<token>`
 *   `path`  — which page to load inside the iframe (defaults to `/`)
 *   `edit`  — passed through to the iframe so the token unlocks edit mode
 */

const rawPath = (Astro.url.searchParams.get("path") || "/").replace(/[?#].*$/, "");
const safePath = rawPath.startsWith("/") ? rawPath : "/" + rawPath;
const editParam = Astro.url.searchParams.get("edit") || "1";
const iframeSrc = `${safePath}${safePath.includes("?") ? "&" : "?"}edit=${encodeURIComponent(editParam)}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>mobile edit — shalagh</title>
    <script is:inline>
      // If we're loaded on a real phone, the phone-in-phone simulation is
      // counter-productive: the user wants to edit the live site directly.
      // Redirect to /<path>?edit=<token> immediately.
      try {
        if (window.matchMedia("(max-width: 767px)").matches) {
          const u = new URL(location.href);
          const path = u.searchParams.get("path") || "/";
          const safePath = path.startsWith("/") ? path : "/" + path;
          const edit = u.searchParams.get("edit") || "1";
          const target = new URL(safePath, location.origin);
          target.searchParams.set("edit", edit);
          location.replace(target.toString());
        }
      } catch (e) {}
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" />
    <style is:global>
      * { box-sizing: border-box; }
      html, body {
        margin: 0; padding: 0; height: 100%;
        background:
          radial-gradient(1200px 600px at 30% 0%, rgba(76, 194, 255, 0.06), transparent 60%),
          radial-gradient(900px 600px at 80% 100%, rgba(255, 204, 0, 0.05), transparent 60%),
          #0e0f12;
        color: #e8ebf0;
        font-family: "Inter", system-ui, sans-serif;
        font-size: 14px;
        overflow: hidden;
      }

      .me-shell {
        display: grid;
        grid-template-rows: auto 1fr;
        height: 100vh;
      }

      /* ---------- Top bar ---------- */

      .me-bar {
        display: flex; align-items: center; gap: 14px;
        padding: 10px 18px;
        background: rgba(16, 17, 22, 0.85);
        backdrop-filter: blur(14px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        flex-wrap: wrap;
      }
      .me-brand {
        display: inline-flex; align-items: center; gap: 10px;
        font-weight: 700; font-size: 14px;
        color: #fff;
      }
      .me-brand .me-pill {
        background: linear-gradient(135deg, #4cc2ff, #6e8bff);
        color: #001020;
        font-size: 10px; font-weight: 800; letter-spacing: 0.06em;
        padding: 3px 8px; border-radius: 4px; text-transform: uppercase;
      }
      .me-bar .me-group {
        display: inline-flex; align-items: center; gap: 4px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 8px;
        padding: 3px;
      }
      .me-bar .me-btn {
        background: transparent; color: #e8ebf0;
        border: 0; border-radius: 6px;
        padding: 6px 10px; font: inherit; font-weight: 500;
        cursor: pointer; text-decoration: none;
        line-height: 1; display: inline-flex; align-items: center; gap: 6px;
        min-height: 30px;
        transition: background 120ms ease;
      }
      .me-bar .me-btn:hover { background: rgba(255, 255, 255, 0.08); }
      .me-bar .me-btn-icon {
        width: 32px; padding: 0; justify-content: center;
        font-size: 16px;
      }

      .me-bar select {
        background: rgba(255, 255, 255, 0.04);
        color: #e8ebf0;
        border: 1px solid rgba(255, 255, 255, 0.08);
        padding: 7px 10px; border-radius: 7px;
        font: inherit; cursor: pointer;
        min-height: 32px;
        min-width: 130px;
      }
      .me-bar select:hover { border-color: rgba(255, 255, 255, 0.18); }

      .me-urlbar {
        flex: 1 1 240px;
        display: inline-flex; align-items: center; gap: 8px;
        background: rgba(255, 255, 255, 0.04);
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 7px;
        padding: 6px 12px;
        color: #b6bccb;
        font-family: "SF Mono", Menlo, Consolas, monospace;
        font-size: 12px;
        min-height: 32px;
        overflow: hidden;
      }
      .me-urlbar .me-host { color: #5d6678; }
      .me-urlbar .me-here {
        color: #e8ebf0;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      }

      .me-bar .me-btn-desktop {
        background: linear-gradient(135deg, #ffcc00, #ffae00);
        color: #1a1200; font-weight: 700;
        padding: 7px 14px;
      }
      .me-bar .me-btn-desktop:hover { filter: brightness(1.06); }
      .me-bar .me-btn-view {
        background: linear-gradient(135deg, #4cc2ff, #2196ee);
        color: #001020; font-weight: 700;
        padding: 7px 14px;
      }
      .me-bar .me-btn-view:hover { filter: brightness(1.06); }
      .me-bar .me-btn-rescue {
        background: linear-gradient(135deg, #ff5a5a, #cc3333);
        color: #fff; font-weight: 700;
        padding: 7px 14px;
      }
      .me-bar .me-btn-rescue:hover { filter: brightness(1.08); }

      /* ---------- Main split: phone on the left, dock on the right ---------- */

      .me-main {
        display: flex;
        gap: 28px;
        align-items: flex-start;
        justify-content: center;
        overflow: auto;
        padding: 30px 18px 40px;
      }

      .me-stage { flex: 0 0 auto; }

      .me-dock {
        flex: 0 1 380px;
        min-width: 280px;
        max-width: 420px;
        align-self: stretch;
        position: sticky;
        top: 30px;
      }
      .me-dock-empty {
        background: rgba(255, 255, 255, 0.04);
        border: 1px dashed rgba(255, 255, 255, 0.18);
        border-radius: 12px;
        padding: 36px 24px;
        color: rgba(255, 255, 255, 0.55);
        text-align: center;
      }
      .me-dock-empty-icon {
        font-size: 26px;
        margin-bottom: 8px;
        color: rgba(255, 255, 255, 0.4);
      }
      .me-dock-empty-title {
        font-size: 14px;
        font-weight: 700;
        color: rgba(255, 255, 255, 0.85);
        text-transform: uppercase;
        letter-spacing: 0.05em;
        margin-bottom: 8px;
      }
      .me-dock-empty-text {
        font-size: 13px;
        line-height: 1.5;
        color: rgba(255, 255, 255, 0.5);
      }
      .me-dock.is-active .me-dock-empty { display: none; }

      /* Docked editor toolbars live in this shell. Styles must be here
         (not injected from the iframe) because cross-document style
         injection from an iframe can fail silently in some setups. */
      .text-edit-toolbar.is-docked,
      .image-edit-toolbar.is-docked,
      .mural-mini-panel.is-docked {
        position: relative;
        display: flex;
        flex-direction: column;
        align-items: stretch;
        gap: 12px;
        background: linear-gradient(180deg, rgba(22, 22, 26, 0.96), rgba(14, 14, 18, 0.96));
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;
        padding: 16px;
        font-family: "Inter", "SF Pro Text", system-ui, sans-serif;
        font-size: 13px;
        color: #e8ebf0;
        box-shadow: 0 12px 32px rgba(0, 0, 0, 0.5);
        overflow: visible;
        max-width: none;
      }

      .text-edit-toolbar.is-docked .te-variant {
        align-self: flex-start;
        background: linear-gradient(135deg, #4cc2ff, #6e8bff);
        color: #001020;
        padding: 4px 10px; border-radius: 5px;
        font-size: 10px; font-weight: 800; letter-spacing: 0.06em;
        text-transform: uppercase;
      }

      .text-edit-toolbar.is-docked .te-edit-text {
        width: 100%; justify-content: center;
        background: linear-gradient(135deg, #ffcc00, #ffae00);
        color: #1a1200;
        border: 0; border-radius: 8px;
        padding: 10px; font: inherit; font-weight: 700;
        cursor: pointer; transition: filter 120ms ease;
      }
      .text-edit-toolbar.is-docked .te-edit-text:hover { filter: brightness(1.08); }

      .text-edit-toolbar.is-docked .te-open-link {
        width: 100%; justify-content: center;
        background: linear-gradient(135deg, #4cc2ff, #2196ee);
        color: #001020;
        border: 0; border-radius: 8px;
        padding: 10px; font: inherit; font-weight: 700;
        cursor: pointer; transition: filter 120ms ease;
      }
      .text-edit-toolbar.is-docked .te-open-link:hover { filter: brightness(1.08); }

      .text-edit-toolbar.is-docked .te-size-stepper {
        display: flex; align-items: center; gap: 4px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        padding: 4px;
      }
      .text-edit-toolbar.is-docked .te-size-stepper button {
        background: transparent; color: #fff; border: 0;
        width: 36px; height: 36px; cursor: pointer;
        font-size: 18px; border-radius: 6px;
        transition: background 120ms ease;
      }
      .text-edit-toolbar.is-docked .te-size-stepper button:hover {
        background: rgba(255, 255, 255, 0.1);
      }
      .text-edit-toolbar.is-docked .te-size-value {
        flex: 1; min-width: 0; width: auto;
        background: transparent; border: 0; outline: 0;
        color: #fff; text-align: center;
        font: inherit; font-size: 16px; padding: 0;
      }
      .text-edit-toolbar.is-docked .te-size-value:focus {
        outline: 1px solid #4cc2ff; outline-offset: 1px; border-radius: 3px;
      }
      .text-edit-toolbar.is-docked .te-size-unit {
        color: rgba(255, 255, 255, 0.45); font-size: 12px; padding-right: 4px;
      }

      .text-edit-toolbar.is-docked select {
        width: 100%;
        background: rgba(255, 255, 255, 0.05);
        color: #fff;
        border: 1px solid rgba(255, 255, 255, 0.1);
        padding: 8px 10px; border-radius: 8px;
        font: inherit;
      }
      .text-edit-toolbar.is-docked select:hover {
        border-color: rgba(255, 255, 255, 0.25);
      }

      .text-edit-toolbar.is-docked .te-bold,
      .text-edit-toolbar.is-docked .te-italic,
      .text-edit-toolbar.is-docked .te-reset {
        background: rgba(255, 255, 255, 0.05); color: #fff;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px; cursor: pointer;
        padding: 9px 14px; font: inherit;
        transition: background 120ms ease;
      }
      .text-edit-toolbar.is-docked .te-bold { font-weight: 800; }
      .text-edit-toolbar.is-docked .te-italic { font-style: italic; }
      .text-edit-toolbar.is-docked .te-reset { color: rgba(255, 255, 255, 0.6); }
      .text-edit-toolbar.is-docked .te-bold:hover,
      .text-edit-toolbar.is-docked .te-italic:hover,
      .text-edit-toolbar.is-docked .te-reset:hover {
        background: rgba(255, 255, 255, 0.1);
      }
      .text-edit-toolbar.is-docked .te-bold.is-on,
      .text-edit-toolbar.is-docked .te-italic.is-on {
        background: linear-gradient(135deg, #4cc2ff, #2196ee);
        color: #001020; border-color: transparent;
      }
      .text-edit-toolbar.is-docked .te-align {
        display: flex; gap: 4px;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px; padding: 4px;
      }
      .text-edit-toolbar.is-docked .te-align-btn {
        flex: 1;
        background: transparent; color: #fff; border: 0;
        padding: 8px; font-size: 16px; border-radius: 6px;
        cursor: pointer; line-height: 1;
        transition: background 120ms ease;
      }
      .text-edit-toolbar.is-docked .te-align-btn:hover {
        background: rgba(255, 255, 255, 0.1);
      }
      .text-edit-toolbar.is-docked .te-align-btn.is-on {
        background: linear-gradient(135deg, #4cc2ff, #2196ee);
        color: #001020;
      }

      .text-edit-toolbar.is-docked .te-rotation {
        display: flex; align-items: center; gap: 8px;
        color: rgba(255, 255, 255, 0.55); font-size: 12px;
      }
      .text-edit-toolbar.is-docked .te-rotation input[type="range"] {
        flex: 1;
      }
      .text-edit-toolbar.is-docked .te-rotation output {
        color: #fff; min-width: 40px; font-variant-numeric: tabular-nums;
        text-align: right;
      }

      .text-edit-toolbar.is-docked input[type="color"] {
        background: transparent;
        border: 1px solid rgba(255, 255, 255, 0.15);
        padding: 0; width: 100%; height: 40px;
        border-radius: 8px; cursor: pointer;
      }

      /* Image toolbar (docked) */
      .image-edit-toolbar.is-docked .ie-btn {
        width: 100%; justify-content: center;
        background: rgba(255, 255, 255, 0.05);
        color: #fff;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px;
        padding: 10px;
        cursor: pointer; font: inherit; font-weight: 600;
        text-align: center; display: flex; align-items: center; gap: 8px;
      }
      .image-edit-toolbar.is-docked .ie-btn:hover {
        background: rgba(255, 255, 255, 0.1);
      }
      .image-edit-toolbar.is-docked .ie-open-link {
        background: linear-gradient(135deg, #4cc2ff, #2196ee);
        color: #001020;
        border: 0; font-weight: 700;
      }
      .image-edit-toolbar.is-docked .ie-reset {
        color: rgba(255, 255, 255, 0.6);
      }
      .image-edit-toolbar.is-docked .ie-field {
        display: flex; align-items: center; gap: 8px;
        color: rgba(255, 255, 255, 0.55); font-size: 12px;
      }
      .image-edit-toolbar.is-docked .ie-field input[type="range"] {
        flex: 1;
      }
      .image-edit-toolbar.is-docked .ie-field output {
        color: #fff; min-width: 44px; text-align: right;
        font-variant-numeric: tabular-nums;
      }

      /* Mural mini panel (docked) */
      .mural-mini-panel.is-docked {
        gap: 14px;
      }
      .mural-mini-panel.is-docked .mural-mini-panel__head {
        display: flex; align-items: center; justify-content: space-between;
        font-size: 14px; font-weight: 700;
      }
      .mural-mini-panel.is-docked .mural-mini-panel__close {
        background: transparent; color: rgba(255, 255, 255, 0.55);
        border: 0; font-size: 22px; cursor: pointer; line-height: 1;
        width: 32px; height: 32px; border-radius: 6px;
      }
      .mural-mini-panel.is-docked .mural-mini-panel__close:hover {
        background: rgba(255, 255, 255, 0.08); color: #fff;
      }
      .mural-mini-panel.is-docked .mural-mini-row {
        display: flex; flex-direction: column; gap: 6px;
        font-size: 12px; color: rgba(255, 255, 255, 0.55);
      }
      .mural-mini-panel.is-docked .mural-mini-row > span {
        text-transform: uppercase; letter-spacing: 0.05em; font-weight: 600;
      }
      .mural-mini-panel.is-docked input[type="text"] {
        background: rgba(255, 255, 255, 0.05); color: #fff;
        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 8px; padding: 9px 11px;
        font: inherit; width: 100%;
      }
      .mural-mini-panel.is-docked input[type="range"] {
        flex: 1;
      }

      /* Phone wrapper styles (kept as a deliberately distinct block from
         the dock so each can be tuned independently). */
      .me-phone {
        position: relative;
        /* Fixed phone dimensions so the editor canvas is the same on
           every host monitor / browser window. The live site adapts
           responsively to whatever device the visitor is on. */
        width: 390px;
        height: 758px;
        background: #000;
        border-radius: 38px;
        padding: 12px;
        box-shadow:
          0 0 0 1.5px rgba(255, 255, 255, 0.08),
          0 0 0 9px #1a1c22,
          0 0 0 10px rgba(255, 255, 255, 0.05),
          0 30px 60px -10px rgba(0, 0, 0, 0.7);
        flex-shrink: 0;
      }
      .me-phone__notch {
        position: absolute;
        top: 18px;
        left: 50%;
        transform: translateX(-50%);
        width: 100px; height: 22px;
        background: #000;
        border-radius: 14px;
        z-index: 2;
      }
      .me-phone__screen {
        position: relative;
        width: 100%; height: 100%;
        background: #fff;
        border-radius: 28px;
        overflow: hidden;
      }
      .me-phone iframe {
        position: absolute; inset: 0;
        width: 100%; height: 100%;
        border: 0; display: block;
        background: #fff;
      }

      .me-meta {
        position: fixed;
        bottom: 14px; left: 50%;
        transform: translateX(-50%);
        color: rgba(255, 255, 255, 0.4);
        font-size: 11px;
        letter-spacing: 0.02em;
        pointer-events: none;
      }

      @media (max-width: 720px) {
        .me-bar { gap: 6px; padding: 8px 10px; }
        .me-urlbar { display: none; }
        .me-stage { padding: 14px 8px; }
        .me-phone { transform: scale(0.85); transform-origin: top center; }
      }
    </style>
  </head>
  <body>
    <div class="me-shell">
      <div class="me-bar">
        <div class="me-brand">
          <span class="me-pill">mobile</span>
          <span>editor</span>
        </div>

        <div class="me-group">
          <button class="me-btn me-btn-icon" id="me-back" title="back">←</button>
          <button class="me-btn me-btn-icon" id="me-fwd" title="forward">→</button>
          <button class="me-btn me-btn-icon" id="me-reload" title="reload">⟳</button>
        </div>

        <select id="me-pages" title="jump to a page">
          <option value="">pages…</option>
          <option value="/">home</option>
          <option value="/about/">about</option>
          <option value="/murals/">murals</option>
          <option value="/portraits/">portraits</option>
          <option value="/prints/">prints</option>
          <option value="/upload/">upload</option>
        </select>

        <div class="me-urlbar">
          <span class="me-host">shalagh.com</span>
          <span class="me-here" id="me-here"></span>
        </div>

        <button class="me-btn me-btn-rescue" id="me-rescue" title="find and reset boxes/images that drifted off-screen">🚨 rescue</button>
        <a class="me-btn me-btn-desktop" id="me-desktop" href="#" title="switch to desktop editor">🖥 desktop</a>
        <a class="me-btn me-btn-view" id="me-view" href="#" target="_blank" rel="noopener" title="open public version">↗ view</a>
      </div>

      <div class="me-main">
        <div class="me-stage">
          <div class="me-phone">
            <div class="me-phone__notch"></div>
            <div class="me-phone__screen">
              <iframe id="me-iframe" src={iframeSrc} title="mobile editor"></iframe>
            </div>
          </div>
        </div>
        <aside class="me-dock" data-toolbar-dock>
          <div class="me-dock-empty" data-dock-empty>
            <div class="me-dock-empty-icon">↖</div>
            <div class="me-dock-empty-title">nothing selected</div>
            <div class="me-dock-empty-text">
              tap a text box or image inside the phone to edit it. its
              controls will appear here, away from the preview.
            </div>
          </div>
        </aside>
      </div>
    </div>

    <div class="me-meta">390 × <span id="me-h"></span>  ·  editing @mobile variant</div>

    <script is:inline define:vars={{ initialPath: safePath }}>
      const iframe = document.getElementById("me-iframe");
      const here = document.getElementById("me-here");
      const pagesSel = document.getElementById("me-pages");
      const desktopLink = document.getElementById("me-desktop");
      const viewLink = document.getElementById("me-view");
      const heightLbl = document.getElementById("me-h");

      const knownPages = new Set(["/", "/about/", "/murals/", "/portraits/", "/prints/", "/upload/"]);

      function withEdit(p) {
        try {
          const u = new URL(p, location.origin);
          u.searchParams.set("edit", "1");
          return u.pathname + u.search;
        } catch { return p; }
      }
      function stripEdit(p) {
        try {
          const u = new URL(p, location.origin);
          u.searchParams.delete("edit");
          return u.pathname + (u.search || "");
        } catch { return p; }
      }
      function updateChrome() {
        try {
          const inner = iframe.contentWindow.location.pathname + iframe.contentWindow.location.search;
          const publicPath = stripEdit(inner);
          here.textContent = publicPath;
          desktopLink.href = withEdit(publicPath);
          viewLink.href = publicPath;
          const url = new URL(location.href);
          url.searchParams.set("path", publicPath);
          if (url.searchParams.get("edit") && url.searchParams.get("edit") !== "1") {
            url.searchParams.set("edit", "1");
          }
          history.replaceState({}, "", url.toString());
          pagesSel.value = knownPages.has(publicPath) ? publicPath : "";
        } catch (e) {}
      }
      function updatePhoneHeight() {
        const phone = document.querySelector(".me-phone__screen");
        if (phone) heightLbl.textContent = Math.round(phone.getBoundingClientRect().height);
      }
      iframe.addEventListener("load", updateChrome);
      window.addEventListener("resize", updatePhoneHeight);
      setTimeout(() => { updateChrome(); updatePhoneHeight(); }, 250);

      document.getElementById("me-back").addEventListener("click", () => {
        try { iframe.contentWindow.history.back(); } catch {}
      });
      document.getElementById("me-fwd").addEventListener("click", () => {
        try { iframe.contentWindow.history.forward(); } catch {}
      });
      document.getElementById("me-reload").addEventListener("click", () => {
        try { iframe.contentWindow.location.reload(); } catch {}
      });
      pagesSel.addEventListener("change", () => {
        if (pagesSel.value) iframe.src = withEdit(pagesSel.value);
      });
    </script>
    <script>
      import { openRescuePanel } from "../../scripts/rescue-panel";
      const rescueBtn = document.getElementById("me-rescue");
      rescueBtn?.addEventListener("click", () => openRescuePanel(document));
    </script>
  </body>
</html>
