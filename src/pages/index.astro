---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

import trustTheProcess from "../assets/images/home/trust-the-process.png";
import starRight from "../assets/images/home/star-right.png";
import starLeft from "../assets/images/home/star-left.png";

/* July 2026 home makeover — 1:1 copy of drorna's PDF mock
   ("home page july 2026.pdf"). Every measurement below is taken
   straight from the PDF (1080-unit-wide artboard) and reproduced
   through the --u CSS unit, so the page scales as one proportional
   sheet. Deliberately imperfect placements (hero not centred, stars
   overlapping the words) are part of the style — do not "fix" them.

   Text defaults live in shalagh-quinn-art/pages/home.md (Obsidian
   vault); the browser editor's site_text overrides still win over
   markdown per element. The writing pill is hidden for now — it will
   come back once its Obsidian-fed page is ready. */

const homeEntry = await getEntry("pages", "home");
const h = homeEntry?.data ?? {};

const offerings =
  h.offerings ?? [
    { label: "mural work", href: "/murals/" },
    { label: "portrait photography", href: "/portraits/" },
    { label: "custom painting" },
    { label: "30 second portraits" },
    { label: "prints", href: "/prints/" },
  ];

// The pill body comes from the plain Obsidian note "Inside Time.md" at
// the vault root — Sheila edits it as a free note, no frontmatter. The
// note's text continues the pill's title ("inside time" … "is a space
// to explore…"), so it renders as-is right under the label.
const insideTimeEntry = await getEntry("notes", "inside-time");
const insideTimeBody = insideTimeEntry?.body?.trim();
const insideTimeText = insideTimeBody
  ? insideTimeBody.split(/\n\s*\n/)
  : h.insideTimeText ?? ["inside time is my astrology project."];
const insideTimeCtaLabel = h.insideTimeCtaLabel ?? "enter inside time";
const insideTimeCtaHref = h.insideTimeCtaHref ?? "https://inside-time.com";

const contactEmail = h.contactEmail ?? "shalaghquinns@gmail.com";
const handles = h.handles ?? ["@shalagh"];
---

<BaseLayout title="shalagh quinn" bare>
  <div class="home">
    <!-- Top bar: upload + left, shalagh right — both in the same Arial
         italic face and size as the pill labels below. -->
    <header class="home-top" aria-label="site header">
      <a href="/upload/" class="home-top__upload" aria-label="upload">
        <span data-editable-text="home.top.uploadLabel">{h.uploadLabel ?? "upload"}</span><span
          class="home-top__upload-plus"
          data-editable-text="home.top.uploadPlus">+</span>
      </a>
      <p class="home-top__logo" data-editable-text="home.top.logo">{h.identityName ?? "shalagh"}</p>
    </header>

    <!-- Hero: handwritten "trust the process" sitting slightly left of
         centre, with the two hand-drawn asterisks floating beside it —
         top-right of "trust", left of "Process". -->
    <section class="home-hero" aria-labelledby="hero-title">
      <h1 id="hero-title" class="home-hero__title">
        <Image
          src={trustTheProcess}
          alt="trust the process"
          widths={[480, 720, 960, 1200]}
          sizes="(min-width: 720px) 477px, 66vw"
          quality={92}
          loading="eager"
          class="home-hero__words"
        />
      </h1>
      <Image
        src={starRight}
        alt=""
        aria-hidden="true"
        widths={[100, 148]}
        sizes="9vw"
        quality={92}
        loading="eager"
        class="home-hero__star home-hero__star--right"
      />
      <Image
        src={starLeft}
        alt=""
        aria-hidden="true"
        widths={[100, 140]}
        sizes="9vw"
        quality={92}
        loading="eager"
        class="home-hero__star home-hero__star--left"
      />
    </section>

    <!-- Category pills. Expandable pills open in place and push the
         rest down. Order per drorna: offerings, about, inside time,
         contact last. writing is hidden until its page is wired up. -->
    <nav class="home-nav" aria-label="primary">
      <!-- offerings -->
      <section class="home-pill home-pill--armed" data-pill>
        <button
          type="button"
          class="home-pill__head"
          data-pill-toggle
          aria-expanded="false"
          aria-controls="pill-offerings"
        >
          <span class="home-pill__label" data-editable-text="home.nav.offerings">{h.navOfferings ?? "offerings"}</span>
        </button>
        <div class="home-pill__body" id="pill-offerings">
          <div class="home-pill__clip">
            <ul class="home-pill__list">
              {offerings.map((o, i) => (
                <li>
                  {o.href ? (
                    <a href={o.href} class="home-pill__row">
                      <span data-editable-text={`home.offerings.item${i}`}>{o.label}</span>
                      <span class="home-pill__arrow" aria-hidden="true">&gt;</span>
                    </a>
                  ) : (
                    <span class="home-pill__row">
                      <span data-editable-text={`home.offerings.item${i}`}>{o.label}</span>
                      <span class="home-pill__arrow" aria-hidden="true">&gt;</span>
                    </span>
                  )}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>

      <!-- about: navigates to the dedicated page -->
      <section class="home-pill home-pill--armed">
        <a href="/about/" class="home-pill__head">
          <span class="home-pill__label" data-editable-text="home.nav.about">{h.navAbout ?? "about"}</span>
        </a>
      </section>

      <!-- inside time: short text ending in a link out to the
           inside-time.com astrology site -->
      <section class="home-pill home-pill--armed" data-pill>
        <button
          type="button"
          class="home-pill__head"
          data-pill-toggle
          aria-expanded="false"
          aria-controls="pill-insidetime"
        >
          <span class="home-pill__label" data-editable-text="home.nav.insidetime">{h.navInsideTime ?? "inside time"}</span>
        </button>
        <div class="home-pill__body" id="pill-insidetime">
          <div class="home-pill__clip">
            <div class="home-pill__list">
              {insideTimeText.map((p, i) => (
                <p class="home-pill__text" data-editable-text={`home.insidetime.p${i}`}>{p}</p>
              ))}
              <a href={insideTimeCtaHref} class="home-pill__row" target="_blank" rel="noopener noreferrer">
                <span data-editable-text="home.insidetime.cta">{insideTimeCtaLabel}</span>
                <span class="home-pill__arrow" aria-hidden="true">&gt;</span>
              </a>
            </div>
          </div>
        </div>
      </section>

      <!-- contact: all contact details, bottom-most pill. Gets its own
           dedicated page later. -->
      <section class="home-pill home-pill--armed" data-pill>
        <button
          type="button"
          class="home-pill__head"
          data-pill-toggle
          aria-expanded="false"
          aria-controls="pill-contact"
        >
          <span class="home-pill__label" data-editable-text="home.nav.contact">{h.navContact ?? "contact"}</span>
        </button>
        <div class="home-pill__body" id="pill-contact">
          <div class="home-pill__clip">
            <ul class="home-pill__list">
              <li>
                <a href={`mailto:${contactEmail}`} class="home-pill__row">
                  <span data-editable-text="home.contact.email">{contactEmail}</span>
                  <span class="home-pill__arrow" aria-hidden="true">&gt;</span>
                </a>
              </li>
              {handles.map((handle, i) => (
                <li>
                  <a
                    href={`https://instagram.com/${handle.replace(/^@/, "")}`}
                    class="home-pill__row"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span data-editable-text={`home.contact.handle${i}`}>{handle}</span>
                    <span class="home-pill__arrow" aria-hidden="true">&gt;</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </section>
    </nav>
  </div>
</BaseLayout>

<script>
  // Pill accordion: a pill with a body toggles open/closed; the grid-rows
  // transition pushes the pills below it down smoothly. Pills without a
  // body (about) are inert for now — they'll get expanded content later.
  document.querySelectorAll<HTMLElement>("[data-pill]").forEach((pill) => {
    const btn = pill.querySelector<HTMLButtonElement>("[data-pill-toggle]");
    const body = pill.querySelector<HTMLElement>(".home-pill__body");
    if (!btn || !body) return;

    btn.addEventListener("click", () => {
      // In edit mode the click must reach the text editor so drorna can
      // rename the label — suppress the expand side-effect.
      const inEditMode =
        document.body.classList.contains("is-text-edit") ||
        document.body.classList.contains("is-image-edit");
      if (inEditMode) return;

      const open = pill.classList.toggle("is-open");
      btn.setAttribute("aria-expanded", String(open));
    });
  });
</script>

<style>
  /* =========================================================
     Home — white sheet, black ink. All measurements are the
     mock's 1080-unit artboard scaled through --u.
     ========================================================= */

  :global(body.is-bare) {
    background: #fff;
    color: #000;
    font-family: Arial, "Helvetica Neue", sans-serif;
  }

  .home {
    --u: calc(min(100vw, 720px) / 1080);
    width: min(100vw, 720px);
    margin: 0 auto;
    min-height: 100vh;
    background: #fff;
    color: #000;
    -webkit-font-smoothing: antialiased;
    padding-bottom: calc(220 * var(--u));
  }

  /* ---------- Top bar ---------- */

  /* Both header items share the pill-label face: Arial italic, 66.5
     units — one visual voice with the boxes below. Small breathing
     room added above. */
  .home-top {
    display: flex;
    align-items: baseline;
    padding: calc(48 * var(--u)) calc(44 * var(--u)) 0 calc(36 * var(--u));
    font-family: Arial, "Helvetica Neue", sans-serif;
    font-style: italic;
    font-size: calc(66.5 * var(--u));
    line-height: 1.15;
  }

  .home-top__logo {
    margin: 0 0 0 auto;
    font-weight: 400;
  }

  /* Framed like a miniature nav pill — same border and radius. */
  .home-top__upload {
    display: inline-flex;
    align-items: baseline;
    gap: calc(14 * var(--u));
    font-weight: 400;
    color: #000;
    text-decoration: none;
    border: max(2px, calc(3 * var(--u))) solid #000;
    border-radius: calc(48 * var(--u));
    padding: calc(16 * var(--u)) calc(44 * var(--u)) calc(20 * var(--u));
  }

  .home-top__upload-plus {
    font-weight: 400;
  }

  /* ---------- Hero ---------- */

  .home-hero {
    position: relative;
    margin-top: calc(130 * var(--u));
  }

  .home-hero__title {
    margin: 0;
    line-height: 0;
  }

  .home-hero__words {
    display: block;
    width: calc(715 * var(--u));
    height: auto;
    margin-left: calc(161 * var(--u));
  }

  .home-hero__star {
    position: absolute;
    height: auto;
  }

  .home-hero__star--right {
    width: calc(97 * var(--u));
    left: calc(861 * var(--u));
    top: calc(108 * var(--u));
  }

  .home-hero__star--left {
    width: calc(97 * var(--u));
    left: calc(64 * var(--u));
    top: calc(601 * var(--u));
  }

  /* ---------- Category pills ---------- */

  .home-nav {
    margin-top: calc(286 * var(--u));
    /* box spans x 79 → 984 on the 1080 artboard */
    padding: 0 calc(96 * var(--u)) 0 calc(79 * var(--u));
    display: flex;
    flex-direction: column;
    gap: calc(55 * var(--u));
  }

  .home-pill {
    border: max(2px, calc(3 * var(--u))) solid #000;
    border-radius: calc(48 * var(--u));
    background: #fff;
  }

  .home-pill__head {
    display: flex;
    align-items: center;
    width: 100%;
    min-height: calc(102.5 * var(--u));
    padding: 0 calc(66 * var(--u));
    background: transparent;
    border: none;
    text-align: left;
    cursor: default;
    color: #000;
    text-decoration: none;
    box-sizing: border-box;
  }

  .home-pill--armed .home-pill__head {
    cursor: pointer;
  }

  .home-pill__label {
    font-family: Arial, "Helvetica Neue", sans-serif;
    font-style: italic;
    font-size: calc(66.5 * var(--u));
    line-height: 1;
    /* optical centre in the mock sits a hair above geometric centre */
    position: relative;
    top: calc(-3 * var(--u));
  }

  /* Expanding body: grid-rows 0fr→1fr animates height without JS
     measurement, pushing the pills below smoothly. */
  .home-pill__body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s cubic-bezier(0.22, 0.7, 0.18, 1);
  }

  .home-pill.is-open .home-pill__body {
    grid-template-rows: 1fr;
  }

  /* Clip wrapper keeps the padded list from adding height while the
     grid row is collapsed to 0fr. */
  .home-pill__clip {
    overflow: hidden;
    min-height: 0;
  }

  .home-pill__list {
    list-style: none;
    margin: 0;
    /* first row starts right where the head zone ends; > column ends
       ~88 units in from the box's right edge, per the mock */
    padding: calc(2 * var(--u)) calc(88 * var(--u)) calc(60 * var(--u))
      calc(73 * var(--u));
  }

  .home-pill__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: "Times New Roman", Times, serif;
    font-size: calc(46.6 * var(--u));
    line-height: calc(72 * var(--u));
    color: #000;
    text-decoration: none;
  }

  .home-pill__arrow {
    font-family: "Times New Roman", Times, serif;
  }

  /* Free paragraphs inside an expanded pill (inside time) — italic
     Times body text in the spirit of the mock's inner-page sample. */
  .home-pill__text {
    margin: 0 0 calc(28 * var(--u));
    font-family: "Times New Roman", Times, serif;
    font-style: italic;
    font-size: calc(40 * var(--u));
    line-height: 1.5;
  }
</style>
