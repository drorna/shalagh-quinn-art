---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import EditableText from "../components/EditableText.astro";

import trustTheProcess from "../assets/images/home/trust-the-process.png";
import theProcess from "../assets/images/home/the-process.png";
import instaLogo from "../assets/images/home/insta-logo.png";
import handAbout from "../assets/images/home/hand-about.png";
import handMurals from "../assets/images/home/hand-murals.png";
import handPortraits from "../assets/images/home/hand-portraits.png";
import handPrints from "../assets/images/home/hand-prints.png";
import coverAbout from "../assets/images/home/cover-about.jpg";
import coverMurals from "../assets/images/home/cover-murals.jpg";
import coverPortraits from "../assets/images/home/cover-portraits.jpg";

// Single cover image for prints — first sorted print artwork stands in
// until Drorna swaps in a dedicated cover via the editor.
const printImports = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/prints/print-*.{jpg,jpeg,png}",
  { eager: true }
);
const coverPrints = Object.entries(printImports)
  .sort(([a], [b]) => a.localeCompare(b))
  .map(([, mod]) => mod.default)[0];

// Identity + section subtitles + handles all live in /content/pages/home.md
// (Obsidian-editable). Markdown sets the defaults; the in-browser editor's
// site_text overrides still win for individual elements.
const homeEntry = await getEntry("pages", "home");
const h = homeEntry?.data ?? {};

const handles =
  h.handles ?? [
    "@shalagh",
    "@thetimeapttern",
    "@iseeloveinyoureyes",
    "@slowlyrememberingwhy",
  ];

const sections = [
  {
    id: "about",
    hand: handAbout,
    handAlt: "about",
    subtitle: h.sectionAboutSubtitle ?? "a trust in process",
    cover: coverAbout,
    coverAlt: "Drawing of a rainbow-colored figure crouching",
    href: "/about/",
  },
  {
    id: "murals",
    hand: handMurals,
    handAlt: "Murals",
    subtitle: h.sectionMuralsSubtitle ?? "the journey",
    cover: coverMurals,
    coverAlt: "Mural with green, yellow and pink flowing forms",
    href: "/murals/",
  },
  {
    id: "portraits",
    hand: handPortraits,
    handAlt: "Portraits",
    subtitle: h.sectionPortraitsSubtitle ?? "the people",
    cover: coverPortraits,
    coverAlt: "Portrait preview",
    href: "/portraits/",
  },
  {
    id: "prints",
    hand: handPrints,
    handAlt: "Prints",
    subtitle: h.sectionPrintsSubtitle ?? "the sale",
    cover: coverPrints,
    coverAlt: "Print preview",
    href: "/prints/",
  },
];
---

<BaseLayout title="shalagh quinn" bare>
  <div class="home">
    <!-- Top bar: explore (left) and upload (right). Sits above the hero
         on a row of its own so the hero image sits cleanly underneath
         the two labels without overlap. -->
    <header class="home-topbar" aria-label="primary">
      <button
        type="button"
        class="home-topbar__btn home-topbar__explore"
        data-explore-toggle
        aria-controls="explore-curtain"
        aria-expanded="false"
        aria-label="explore"
      >
        <span data-editable-text="home.hero.exploreLabel">{h.exploreLabel ?? "explore"}</span><span class="home-topbar__btn-mark" aria-hidden="true" data-editable-text="home.hero.exploreMark">&gt;</span>
      </button>

      <a href="/upload/" class="home-topbar__btn home-topbar__upload" aria-label="upload">
        <span data-editable-text="home.hero.uploadLabel">{h.uploadLabel ?? "upload"}</span><span class="home-topbar__btn-mark" data-editable-text="home.hero.uploadPlus">+</span>
      </a>
    </header>

    <!-- Hero: trust the process (mobile) / the process (desktop) -->
    <section class="home-hero" aria-labelledby="hero-title">
      <h1 id="hero-title" class="home-hero__title">
        <div class="home-hero__variant home-hero__variant--mobile">
          <Image
            src={trustTheProcess}
            alt="trust the process"
            widths={[480, 720, 960, 1200]}
            sizes="(min-width: 900px) 860px, 86vw"
            quality={92}
            loading="eager"
            class="home-hero__title-img"
          />
        </div>
        <div class="home-hero__variant home-hero__variant--desktop">
          <Image
            src={theProcess}
            alt="the process"
            widths={[480, 720, 960, 1200]}
            sizes="(min-width: 900px) 860px, 86vw"
            quality={92}
            loading="eager"
            class="home-hero__title-img"
          />
        </div>
      </h1>
    </section>

    <!-- Identity stack. Per drorna's layout spec:
           name + pronunciation = left aligned
           contact label + email = right aligned
           IG icon + handles = left aligned
         No two-column row; each block sits on its own line aligned
         to one side, top-to-bottom.  -->
    <header class="home-meta" aria-label="primary">
      <div class="home-meta-block home-meta-block--left">
        <EditableText id="home.identity.name" tag="p" class="home-identity__name">{h.identityName ?? "Shalagh"}</EditableText>
        <EditableText id="home.identity.pron" tag="p" class="home-identity__pron">{h.identityPron ?? "pronounced shay - la"}</EditableText>
      </div>

      <div class="home-meta-block home-meta-block--right">
        <span class="home-identity__contact-label" data-editable-text="home.identity.contactLabel">{h.contactLabel ?? "contact"}</span>
        <a href={`mailto:${h.contactEmail ?? "shalaghquinns@gmail.com"}`} class="home-identity__email" data-editable-text="home.identity.contactEmail">
          {h.contactEmail ?? "shalaghquinns@gmail.com"}
        </a>
      </div>

      <div class="home-meta-block home-meta-block--left">
        <a
          href="https://instagram.com/shalagh"
          target="_blank"
          rel="noopener noreferrer"
          class="home-identity__ig"
          aria-label="instagram"
        >
          <Image
            src={instaLogo}
            alt="instagram"
            widths={[80, 120, 200]}
            sizes="48px"
            quality={92}
            loading="eager"
            class="home-identity__ig-img"
          />
        </a>
        <ul class="home-identity__handles">
          {handles.map((h) => (
            <li>{h}</li>
          ))}
        </ul>
      </div>
    </header>

    <!-- Sections -->
    <div class="home-sections">
      {sections.map((s) => (
        <section class="home-section" id={s.id} aria-labelledby={`${s.id}-title`}>
          <div class="home-section__head">
            <div class="home-section__title-block">
              <a href={s.href} class="home-section__title-link" aria-label={s.handAlt}>
                <Image
                  src={s.hand}
                  alt={s.handAlt}
                  widths={[400, 600, 800]}
                  sizes="(min-width: 900px) 460px, 60vw"
                  quality={92}
                  loading="lazy"
                  id={`${s.id}-title`}
                  class:list={["home-section__hand", `home-section__hand--${s.id}`]}
                />
              </a>
              <EditableText id={`home.section.${s.id}.subtitle`} tag="p" class="home-section__subtitle">{s.subtitle}</EditableText>
            </div>
            <a href={s.href} class="home-section__enter" aria-label={`enter ${s.handAlt}`} data-editable-text={`home.section.${s.id}.enter`}>
              <span aria-hidden="true">&gt;</span>
            </a>
          </div>

          {s.cover && (
            <a href={s.href} class="home-section__cover-link" aria-label={s.handAlt}>
              <Image
                src={s.cover}
                alt={s.coverAlt}
                widths={[600, 900, 1200, 1600]}
                sizes="(min-width: 900px) 720px, 90vw"
                quality={86}
                loading="lazy"
                class="home-section__cover"
              />
            </a>
          )}
        </section>
      ))}
    </div>

    <!-- Extras canvas: editable empty real estate at the end of the home
         page. Custom floating boxes from the editor's "+ text" tool
         anchor to body (absolute positioning), but absolute elements
         don't grow their parent's scroll height — so this section
         contributes the vertical room. Drop custom text / image boxes
         anywhere over this area to keep extending the page over time.
         Invisible to visitors until populated. -->
    <section class="home-extras" aria-label="more"></section>
  </div>

  <!-- Explore curtain: full-screen black overlay with handwritten section
       titles in white. Triggered by the top-left EXPLORE button; closes on
       the in-curtain X, on link click, or with Escape. -->
  <aside
    id="explore-curtain"
    class="explore-curtain"
    data-explore-curtain
    aria-hidden="true"
    aria-label="explore menu"
  >
    <button
      type="button"
      class="explore-curtain__close"
      data-explore-toggle
      aria-label="close menu"
    >
      <span aria-hidden="true">&times;</span>
    </button>

    <nav class="explore-curtain__nav" aria-label="explore navigation">
      <a href="/about/" class="explore-curtain__link">
        <Image
          src={handAbout}
          alt="about"
          widths={[400, 600, 800]}
          sizes="(min-width: 700px) 360px, 60vw"
          quality={92}
          loading="lazy"
          class="explore-curtain__img"
        />
      </a>
      <a href="/murals/" class="explore-curtain__link">
        <Image
          src={handMurals}
          alt="Murals"
          widths={[400, 600, 800]}
          sizes="(min-width: 700px) 360px, 60vw"
          quality={92}
          loading="lazy"
          class="explore-curtain__img"
        />
      </a>
      <a href="/portraits/" class="explore-curtain__link">
        <Image
          src={handPortraits}
          alt="Portraits"
          widths={[400, 600, 800]}
          sizes="(min-width: 700px) 360px, 60vw"
          quality={92}
          loading="lazy"
          class="explore-curtain__img"
        />
      </a>
      <a href="/prints/" class="explore-curtain__link">
        <Image
          src={handPrints}
          alt="Prints"
          widths={[400, 600, 800]}
          sizes="(min-width: 700px) 360px, 60vw"
          quality={92}
          loading="lazy"
          class="explore-curtain__img"
        />
      </a>
    </nav>
  </aside>

</BaseLayout>

<script>
  // Curtain toggle. Mirrors any [data-explore-toggle] click into an
  // `is-open` class on the curtain + body, and handles Escape to close.
  const curtain = document.querySelector<HTMLElement>("[data-explore-curtain]");
  const triggers = document.querySelectorAll<HTMLElement>("[data-explore-toggle]");

  function setOpen(open: boolean) {
    if (!curtain) return;
    curtain.classList.toggle("is-open", open);
    curtain.setAttribute("aria-hidden", String(!open));
    document.body.classList.toggle("is-explore-open", open);
    triggers.forEach((t) => t.setAttribute("aria-expanded", String(open)));
  }

  triggers.forEach((t) =>
    t.addEventListener("click", () => {
      const isOpen = curtain?.classList.contains("is-open");
      // In edit mode, a click on the EXPLORE button must reach the
      // text editor so drorna can change the label. Suppress the
      // open-the-curtain side-effect; closing (when already open) is
      // still allowed so the in-curtain × keeps working.
      const inEditMode =
        document.body.classList.contains("is-text-edit") ||
        document.body.classList.contains("is-image-edit");
      if (!isOpen && inEditMode) return;
      setOpen(!isOpen);
    })
  );

  // Closing on link click — the navigation runs immediately after, but
  // the curtain transitioning closed makes the back-button hit feel right.
  curtain?.querySelectorAll<HTMLAnchorElement>(".explore-curtain__link").forEach((a) =>
    a.addEventListener("click", () => setOpen(false))
  );

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && curtain?.classList.contains("is-open")) setOpen(false);
  });
</script>

<style>
  /* =========================================================
     Home — mint background, ink display
     ========================================================= */

  :global(body.is-bare) {
    background: var(--color-mint);
    color: var(--color-ink);
    font-family: var(--font-sans);
  }

  .home {
    min-height: 100vh;
    background: var(--color-mint);
    color: var(--color-ink);
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
  }

  /* ---------- Hero ---------- */

  .home-hero {
    position: relative;
    padding: clamp(24px, 7vw, 40px) clamp(16px, 5vw, 24px) clamp(28px, 8vw, 48px);
    display: flex;
    /* Centred again — drorna asked to bring the title image back down
       to the middle of the hero viewport. */
    align-items: center;
    justify-content: center;
    min-height: 78vh;
  }

  /* ---------- Top bar (explore left, upload right) ---------- */

  .home-topbar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: clamp(14px, 4vw, 18px) clamp(16px, 5vw, 24px) 0;
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
  }

  .home-topbar__btn {
    font-family: Arial, "Helvetica Neue", sans-serif;
    font-size: clamp(0.85rem, 3.4vw, 1rem);
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--color-ink);
    display: inline-flex;
    align-items: baseline;
    gap: 0.35em;
    background: transparent;
    border: none;
    padding: 0;
    cursor: pointer;
    line-height: 1;
  }

  .home-topbar__btn-mark {
    font-weight: 400;
    font-size: 1em;
    line-height: 1;
  }

  .home-hero__title {
    margin: 0;
    width: min(86vw, 860px);
    /* flex-shrink: 0 stops flexbox from squishing the title below its
       declared width when the editor's image wrapper or any other child
       reports a larger intrinsic basis — without this the hero image
       renders ~10% narrower in the editor than on the live phone. */
    flex-shrink: 0;
    line-height: 0;
  }

  .home-hero__title-img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* Mobile-vs-desktop hero variants. Wrap each <Image> in a div so
     display:none collapses the editor's auto-tagged span wrapper too. */
  .home-hero__variant { line-height: 0; width: min(82vw, 520px); }
  .home-hero__variant--desktop { display: none; }
  @media (min-width: 1024px) {
    .home-hero__variant--mobile  { display: none; }
    .home-hero__variant--desktop { display: block; width: min(86vw, 860px); }
  }

  /* ---------- Identity + contact ---------- */

  /* Step gaps generous (~100 px on phone) with a slightly larger
     bottom padding so the about transition still reads as the
     biggest break — but every gap stays within a balanced range. */
  .home-meta {
    padding: clamp(24px, 7vw, 40px) clamp(20px, 6vw, 32px)
             clamp(80px, 20vw, 128px);
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    gap: clamp(96px, 25vw, 160px);
  }

  /* Each meta block is its own row; alignment switches per block. */
  .home-meta-block {
    display: flex;
    flex-direction: column;
  }

  .home-meta-block--left {
    align-items: flex-start;
    text-align: left;
  }

  .home-meta-block--right {
    align-items: flex-end;
    text-align: right;
  }

  /* EditableText renders these via its own component, so the index
     page's data-astro-cid scoping doesn't reach them. `:global()`
     keeps the rules unscoped. */
  :global(.home-identity__name) {
    margin: 0;
    font-family: var(--font-sans);
    /* ~25 % smaller than the previous 3.4-4.6 rem so it reads as a
       confident display weight, not a poster headline. */
    font-size: clamp(2.55rem, 9.75vw, 3.45rem);
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1;
  }

  :global(.home-identity__pron) {
    margin: 0;
    font-family: var(--font-sans);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(0.95rem, 3.4vw, 1.1rem);
    color: var(--color-ink);
    opacity: 0.78;
  }

  .home-identity__contact-label {
    font-family: var(--font-sans);
    font-style: italic;
    font-weight: 600;
    font-size: clamp(1rem, 3.6vw, 1.2rem);
    color: var(--color-ink);
    line-height: 1.1;
  }

  .home-identity__email {
    margin-top: 4px;
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: clamp(0.8rem, 2.7vw, 0.95rem);
    color: var(--color-ink);
    opacity: 0.78;
    word-break: break-all;
  }

  .home-identity__ig {
    display: inline-flex;
    width: clamp(44px, 12vw, 56px);
    height: clamp(44px, 12vw, 56px);
    align-items: center;
    justify-content: center;
    color: var(--color-ink);
    margin-bottom: 10px;
  }

  .home-identity__ig-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  .home-identity__handles {
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-sans);
    font-style: italic;
    font-weight: 500;
    font-size: clamp(0.9rem, 3vw, 1rem);
    color: var(--color-ink);
    line-height: 1.55;
  }

  /* ---------- Sections ---------- */

  .home-sections {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0 clamp(16px, 5vw, 24px) clamp(40px, 12vw, 80px);
    display: flex;
    flex-direction: column;
    /* Roomy but not dramatic gap between sections — about ~12 vh
       on a phone — so each section still has its own dedicated
       viewport but transitions feel deliberate, not vast. */
    gap: 12vh;
  }

  .home-section {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: clamp(16px, 4vw, 28px);
    min-height: 100vh;
    padding-block: clamp(20px, 5vw, 32px);
  }

  /* Grid keeps the > arrow vertically centred with the handwritten
     title image only — the subtitle below the title is on its own
     row, with the arrow's column empty there. */
  .home-section__head {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-rows: auto auto;
    grid-template-areas:
      "title   arrow"
      "subtitle .";
    column-gap: var(--sp-4);
    row-gap: 6px;
    align-items: center;
  }

  .home-section__title-link { grid-area: title; align-self: center; }
  .home-section__enter      { grid-area: arrow; align-self: center; }
  :global(.home-section__subtitle) { grid-area: subtitle; }

  .home-section__title-block {
    display: contents;
  }

  .home-section__title-link {
    display: inline-block;
    line-height: 0;
  }

  :global(.home-section__subtitle) {
    margin: 6px 0 0;
    font-family: "Times New Roman", Times, serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(0.95rem, 3.4vw, 1.1rem);
    color: var(--color-ink);
    opacity: 0.85;
  }

  .home-section__hand {
    display: block;
    height: auto;
    width: auto;
    max-width: 100%;
  }

  /* All four section titles share one handwriting size so about doesn't
     read as a different hierarchy than murals / portraits / prints. */
  .home-section__hand--about,
  .home-section__hand--murals,
  .home-section__hand--portraits,
  .home-section__hand--prints {
    max-height: clamp(64px, 12vw, 110px);
  }

  .home-section__enter {
    font-family: var(--font-sans);
    font-size: clamp(1.6rem, 6vw, 2.2rem);
    font-weight: 500;
    color: var(--color-ink);
    line-height: 1;
    display: inline-flex;
    align-items: center;
  }

  .home-section__cover-link {
    display: block;
    width: min(100%, 720px);
    align-self: center;
  }

  .home-section__cover {
    display: block;
    width: 100%;
    height: auto;
  }

  /* ---------- Extras canvas (bottom of page) ---------- */

  .home-extras {
    /* Collapsed by request — drorna doesn't want a tall empty tail
       on the home page. Bump min-height back if you ever need
       landing room for floating editor boxes. */
    width: 100%;
    min-height: 0;
  }

  /* ---------- Explore curtain ---------- */

  .explore-curtain {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: #000;
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: clamp(var(--sp-6), 8vw, var(--sp-12)) var(--sp-4);
    /* Slide-down "curtain": starts above the viewport and translates
       into place. transform is hardware-accelerated so the animation
       stays smooth across phones. */
    transform: translateY(-100%);
    transition: transform 0.55s cubic-bezier(0.22, 0.7, 0.18, 1);
    pointer-events: none;
    overscroll-behavior: contain;
  }

  .explore-curtain.is-open {
    transform: translateY(0);
    pointer-events: auto;
  }

  :global(body.is-explore-open) {
    overflow: hidden;
  }

  .explore-curtain__close {
    position: absolute;
    top: clamp(var(--sp-3), 4vw, var(--sp-5));
    right: clamp(var(--sp-3), 4vw, var(--sp-5));
    background: transparent;
    border: none;
    color: #fff;
    font-family: Arial, "Helvetica Neue", sans-serif;
    font-size: clamp(2rem, 4vw, 2.6rem);
    font-weight: 300;
    line-height: 1;
    cursor: pointer;
    padding: var(--sp-1) var(--sp-2);
  }

  .explore-curtain__nav {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(var(--sp-6), 7vw, var(--sp-12));
    width: 100%;
    max-width: 540px;
  }

  .explore-curtain__link {
    display: block;
    line-height: 0;
    opacity: 0;
    transform: translateY(12px);
    transition:
      opacity 0.45s ease-out var(--curtain-delay, 0s),
      transform 0.45s ease-out var(--curtain-delay, 0s);
  }

  .explore-curtain.is-open .explore-curtain__link {
    opacity: 1;
    transform: translateY(0);
  }

  /* Stagger the link reveal so they fall in one after another. */
  .explore-curtain__link:nth-child(1) { --curtain-delay: 0.18s; }
  .explore-curtain__link:nth-child(2) { --curtain-delay: 0.26s; }
  .explore-curtain__link:nth-child(3) { --curtain-delay: 0.34s; }
  .explore-curtain__link:nth-child(4) { --curtain-delay: 0.42s; }

  .explore-curtain__img {
    display: block;
    width: 100%;
    height: auto;
    max-width: clamp(220px, 60vw, 360px);
    /* Handwriting source is black ink — invert to render in white on the
       curtain's black background. Matches the inner-page title treatment. */
    filter: invert(1);
  }

  /* ---------- Responsive tweaks ---------- */

  @media (min-width: 700px) {
    .home-hero {
      padding: var(--sp-5) var(--sp-8);
    }
    .home-meta {
      padding: var(--sp-4) var(--sp-8) var(--sp-8);
    }
    .home-sections {
      padding: 0 var(--sp-8) var(--sp-16);
      gap: var(--sp-12);
    }
  }
</style>
