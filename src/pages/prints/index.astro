---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EditableText from "../../components/EditableText.astro";
import type { ImageMetadata } from "astro";
import handPrints from "../../assets/images/prints/_hand-prints.png";

// Page copy from /content/pages/prints.md (Obsidian-editable).
const printsEntry = await getEntry("pages", "prints");
const prf = printsEntry?.data ?? { title: "Prints" };

const imports = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/images/prints/print-*.{jpg,jpeg,JPG,JPEG,png,PNG,webp}",
  { eager: true }
);

const prints = Object.entries(imports)
  .map(([path, mod]) => ({
    src: mod.default,
    filename: (path.split("/").pop() || "image").trim(),
  }))
  .sort((a, b) => a.filename.localeCompare(b.filename));
---

<BaseLayout title="prints — shalagh quinn" bare>
  <div class="prints-page">
    <a href="/" class="prints-page__back" aria-label="back home">
      <span aria-hidden="true">&lt;</span>
    </a>

    <header class="prints-page__header">
      <h1 class="prints-page__title">
        <Image
          src={handPrints}
          alt={prf.title}
          widths={[400, 600, 800]}
          sizes="(min-width: 900px) 420px, 60vw"
          quality={92}
          loading="eager"
          class="prints-page__title-img"
        />
      </h1>
      {prf.subtitle && (
        <EditableText id="prints.subtitle" tag="p" class="prints-page__subtitle">{prf.subtitle}</EditableText>
      )}
    </header>

    <section class="prints-grid" aria-label="prints gallery">
      {prints.map((p) => (
        <figure class="prints-grid__figure">
          <Image
            src={p.src}
            alt={p.filename.replace(/\.[^.]+$/, "").replace(/[-_]+/g, " ")}
            widths={[400, 600, 900, 1200]}
            sizes="(min-width: 1000px) 32vw, (min-width: 600px) 47vw, 90vw"
            quality={82}
            loading="lazy"
            class="prints-grid__img"
          />
        </figure>
      ))}
    </section>
  </div>
</BaseLayout>

<style>
  :global(body.is-bare) {
    background: #000;
    color: #fff;
    font-family: var(--font-sans);
  }

  .prints-page {
    background: #000;
    color: #fff;
    min-height: 100vh;
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    padding: clamp(var(--sp-4), 5vw, var(--sp-8)) clamp(var(--sp-3), 4vw, var(--sp-8)) var(--sp-16);
    position: relative;
  }

  .prints-page__back {
    position: absolute;
    top: clamp(var(--sp-3), 4vw, var(--sp-6));
    left: clamp(var(--sp-3), 4vw, var(--sp-6));
    color: #fff;
    font-family: Arial, "Arial Hebrew", "Helvetica Neue", sans-serif;
    font-weight: 700;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1;
    opacity: 0.85;
    transition: opacity var(--duration-fast) var(--ease-out);
    z-index: 5;
  }

  .prints-page__back:hover { opacity: 1; }

  .prints-page__header {
    max-width: 1280px;
    margin: 0 auto var(--sp-8);
    padding-top: var(--sp-4);
    text-align: center;
  }

  .prints-page__title {
    margin: 0 0 var(--sp-2);
    line-height: 0;
  }

  .prints-page__title-img {
    width: clamp(220px, 38vw, 380px);
    height: auto;
    filter: invert(1);
  }

  .prints-page__subtitle {
    margin: 0;
    font-family: "Times New Roman", Times, serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.1rem, 1.6vw, 1.4rem);
    color: #fff;
  }

  /* 3-col masonry on desktop, 2 on mobile — same as portraits */
  .prints-grid {
    column-count: 2;
    column-gap: clamp(var(--sp-2), 1vw, var(--sp-3));
    max-width: 1280px;
    margin: 0 auto;
  }

  @media (min-width: 1000px) {
    .prints-grid {
      column-count: 3;
      column-gap: clamp(var(--sp-3), 1.4vw, var(--sp-4));
    }
  }

  .prints-grid__figure {
    margin: 0 0 clamp(var(--sp-2), 1vw, var(--sp-3));
    break-inside: avoid;
    -webkit-column-break-inside: avoid;
    page-break-inside: avoid;
    overflow: hidden;
  }

  @media (min-width: 1000px) {
    .prints-grid__figure {
      margin-bottom: clamp(var(--sp-3), 1.4vw, var(--sp-4));
    }
  }

  .prints-grid__img {
    display: block;
    width: 100%;
    height: auto;
    transition: opacity var(--duration-base) var(--ease-out);
  }

  .prints-grid__figure:hover .prints-grid__img {
    opacity: 0.88;
  }
</style>
