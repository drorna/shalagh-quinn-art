---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<!-- Landing page after an upload (FormSubmit redirects here). Styled in
     the home page's unified language: white sheet, black ink, one
     rounded pill box. Same --u proportional unit system as home. -->
<BaseLayout
  title="thank you — shalagh quinn"
  description="Your upload was sent successfully."
  bare
>
  <div class="sheet">
    <main class="sheet-main">
      <section class="pill">
        <div class="pill__head">
          <h1 class="pill__label" data-editable-text="thanks.title">thank you</h1>
        </div>
        <div class="pill__content">
          <p class="pill__copy" data-editable-text="thanks.copy">your photo has been sent. thank you for sharing your piece.</p>

          <a href="/" class="pill__row">
            <span data-editable-text="thanks.back">back home</span>
            <span class="pill__arrow" aria-hidden="true">&gt;</span>
          </a>
        </div>
      </section>
    </main>
  </div>
</BaseLayout>

<style>
  /* Same sheet system as home / upload. */

  :global(body.is-bare) {
    background: #fff;
    color: #000;
    font-family: Arial, "Helvetica Neue", sans-serif;
  }

  .sheet {
    --u: calc(min(100vw, 720px) / 1080);
    width: min(100vw, 720px);
    margin: 0 auto;
    min-height: 100vh;
    background: #fff;
    color: #000;
    -webkit-font-smoothing: antialiased;
    padding-bottom: calc(220 * var(--u));
  }

  .sheet-main {
    margin-top: calc(140 * var(--u));
    padding: 0 calc(96 * var(--u)) 0 calc(79 * var(--u));
  }

  .pill {
    border: max(2px, calc(3 * var(--u))) solid #000;
    border-radius: calc(48 * var(--u));
    background: #fff;
  }

  .pill__head {
    display: flex;
    align-items: center;
    min-height: calc(102.5 * var(--u));
    padding: 0 calc(66 * var(--u));
  }

  .pill__label {
    margin: 0;
    font-family: Arial, "Helvetica Neue", sans-serif;
    font-style: italic;
    font-weight: 400;
    font-size: calc(66.5 * var(--u));
    line-height: 1;
    position: relative;
    top: calc(-3 * var(--u));
  }

  .pill__content {
    padding: calc(2 * var(--u)) calc(88 * var(--u)) calc(70 * var(--u))
      calc(73 * var(--u));
  }

  .pill__copy {
    margin: 0 0 calc(60 * var(--u));
    font-family: "Times New Roman", Times, serif;
    font-style: italic;
    font-size: calc(40 * var(--u));
    line-height: 1.5;
  }

  .pill__row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: "Times New Roman", Times, serif;
    font-size: calc(46.6 * var(--u));
    line-height: calc(72 * var(--u));
    color: #000;
    text-decoration: none;
  }

  .pill__arrow {
    font-family: "Times New Roman", Times, serif;
  }
</style>
