---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Thank you — Shalagh Quinn"
  description="Your message was sent successfully."
>
  <section class="thanks">
    <div class="container thanks__inner">
      <h1 class="thanks__title">thank you.</h1>
      <p class="thanks__lede italic">
        your message has been sent. I read everything personally and usually
        reply within a few days.
      </p>

      <div class="thanks__actions">
        <a href="/" class="thanks__link">
          <span class="thanks__arrow" aria-hidden="true">‹</span>
          <span>back to home</span>
        </a>
        <a href="/#work" class="thanks__link">
          <span>browse the work</span>
          <span class="thanks__arrow" aria-hidden="true">›</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .thanks {
    min-height: 60vh;
    padding-block: var(--sp-12) var(--sp-16);
    display: flex;
    align-items: center;
  }

  .thanks__inner {
    max-width: 640px;
  }

  .thanks__title {
    font-family: var(--font-serif);
    font-weight: 400;
    color: var(--color-ink);
    line-height: 1;
    letter-spacing: -0.01em;
    margin: 0 0 var(--sp-3);
    font-size: clamp(2.5rem, 7vw, 5rem);
  }

  .thanks__lede {
    font-family: var(--font-serif);
    font-size: var(--fs-md);
    line-height: 1.6;
    color: var(--color-ink-soft);
    margin: 0 0 var(--sp-6);
    max-width: 52ch;
  }

  .thanks__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-4);
  }

  .thanks__link {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3em;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--fs-md);
    color: var(--color-ink);
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 2px;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .thanks__link:hover {
    border-bottom-color: var(--color-ink);
  }

  .thanks__arrow {
    font-weight: 300;
    font-style: normal;
    transition: transform var(--duration-base) var(--ease-out);
    display: inline-block;
  }

  .thanks__link:hover .thanks__arrow {
    transform: translateX(4px);
  }

  .thanks__link:first-child:hover .thanks__arrow {
    transform: translateX(-4px);
  }
</style>
