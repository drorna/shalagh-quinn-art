---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import handMurals from "../../assets/images/murals/_hand-murals.png";
---

<BaseLayout title="murals — shalagh quinn" bare>
  <div class="murals-page">
    <a href="/" class="murals-page__back" aria-label="back home">
      <span aria-hidden="true">&lt;</span>
    </a>

    <!-- Intro -->
    <section class="murals-intro">
      <h1 class="murals-intro__title">
        <Image
          src={handMurals}
          alt="Murals"
          widths={[400, 600, 800]}
          sizes="(min-width: 900px) 320px, 55vw"
          quality={92}
          loading="eager"
          class="murals-intro__title-img"
        />
      </h1>
      <p class="murals-intro__journey">the jounrey</p>
      <div class="murals-intro__copy">
        <p>since 2020 I have been travelling and painitng walls through exchanges.</p>
        <p>I have let the art be my guide moving me through many wordls painting cafes, restuaurants, hostels, and guesthouses.</p>
        <p class="murals-intro__copy-end">enjoy the journey</p>
      </div>
    </section>

    <!-- Free-positioning canvas: tiles are absolutely positioned in % -->
    <section class="murals-canvas" data-mural-canvas aria-label="murals">
      <div class="murals-canvas__loading" data-loading>loading…</div>
    </section>
  </div>

  <script>
    import { initMuralsBoard } from "../../scripts/murals-board";
    initMuralsBoard();
  </script>
</BaseLayout>

<style>
  :global(body.is-bare) {
    background: #000;
    color: #fff;
    font-family: var(--font-sans);
  }

  .murals-page {
    background: #000;
    color: #fff;
    min-height: 100vh;
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    padding: clamp(var(--sp-4), 5vw, var(--sp-8)) clamp(var(--sp-3), 4vw, var(--sp-8)) var(--sp-16);
    position: relative;
  }

  .murals-page__back {
    position: absolute;
    top: clamp(var(--sp-3), 4vw, var(--sp-6));
    left: clamp(var(--sp-3), 4vw, var(--sp-6));
    color: #fff;
    font-family: Arial, "Arial Hebrew", "Helvetica Neue", sans-serif;
    font-weight: 700;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1;
    opacity: 0.85;
    transition: opacity var(--duration-fast) var(--ease-out);
    z-index: 5;
  }

  .murals-page__back:hover { opacity: 1; }

  /* ---------- Intro ---------- */
  .murals-intro {
    max-width: 720px;
    margin: 0 auto var(--sp-8);
  }
  .murals-intro__title { margin: 0 0 var(--sp-4); line-height: 0; }
  .murals-intro__title-img {
    width: clamp(220px, 32vw, 360px);
    height: auto;
    filter: invert(1);
  }
  .murals-intro__journey {
    margin: 0 0 var(--sp-5);
    font-family: "Times New Roman", Times, serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.6rem, 3.2vw, 2.4rem);
    color: #fff;
  }
  .murals-intro__copy {
    font-family: "Times New Roman", Times, serif;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    font-weight: 400;
    line-height: 1.6;
    color: #fff;
    max-width: 40ch;
  }
  .murals-intro__copy p { margin: 0 0 var(--sp-3); }
  .murals-intro__copy-end { margin-top: var(--sp-4) !important; }

  /* ---------- Free-positioning canvas ----------
     Tile + handle styles live in murals-board.ts (JS-injected, global)
     because Astro's scoped CSS doesn't reach DOM created dynamically. */
  .murals-canvas {
    position: relative;
    max-width: 1280px;
    margin: 0 auto;
    /* Height is set by JS to fit the bottom-most tile. Initial floor: */
    min-height: 80vh;
  }

  .murals-canvas__loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #555;
    font-family: monospace;
  }
</style>
