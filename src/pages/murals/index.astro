---
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import EditableText from "../../components/EditableText.astro";
import handMurals from "../../assets/images/murals/_hand-murals.png";
import { supabase, type MuralTile } from "../../lib/supabase";

// Build-time tile fetch so the page paints with content on first byte —
// no "loading…" flicker, no client-side round trip to Supabase before
// anything appears. The JS still runs and updates if data changed since
// the last build (realtime sync), but the visitor sees the murals
// immediately.
let ssrTiles: MuralTile[] = [];
try {
  const { data, error } = await supabase
    .from("mural_tiles")
    .select("*")
    .eq("page", "home")
    .order("y", { ascending: true })
    .order("x", { ascending: true })
    .order("order_idx", { ascending: true });
  if (error) console.warn("[murals SSR] fetch error", error);
  ssrTiles = (data || []) as MuralTile[];
} catch (e) {
  console.warn("[murals SSR] Supabase unreachable; falling back to JS render", e);
}

function autoHref(t: MuralTile): string | null {
  if (t.href) return t.href;
  if (!t.label) return null;
  const slug = t.label
    .toLowerCase()
    .normalize("NFD")
    .replace(/[̀-ͯ]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
  return slug ? `/murals/${slug}/` : null;
}
function transformedSrc(src: string | null | undefined): string {
  // Pass through — Supabase's render endpoint requires Image Transforms
  // to be enabled on the project and was returning 403 on this account.
  return src || "";
}
function tileStyle(t: MuralTile): string {
  return [
    `left:${t.x}cqw`,
    `top:${t.y}cqw`,
    `width:${t.w}cqw`,
    `height:${t.h}cqw`,
    `z-index:${t.order_idx || 0}`,
    t.rotation ? `transform:rotate(${t.rotation}deg)` : "",
  ].filter(Boolean).join(";");
}
const maxBottom = ssrTiles.reduce((m, t) => Math.max(m, t.y + t.h), 0);
---

<BaseLayout title="murals — shalagh quinn" bare>
  <div class="murals-page">
    <a href="/" class="murals-page__back" aria-label="back home">
      <span aria-hidden="true">&lt;</span>
    </a>

    <!-- Intro -->
    <section class="murals-intro">
      <h1 class="murals-intro__title">
        <Image
          src={handMurals}
          alt="Murals"
          widths={[400, 600, 800]}
          sizes="(min-width: 900px) 320px, 55vw"
          quality={92}
          loading="eager"
          class="murals-intro__title-img"
        />
      </h1>
      <EditableText id="murals.intro.journey" tag="p" class="murals-intro__journey">the jounrey</EditableText>
      <div class="murals-intro__copy">
        <EditableText id="murals.intro.p1" tag="p">since 2020 I have been travelling and painitng walls through exchanges.</EditableText>
        <EditableText id="murals.intro.p2" tag="p">I have let the art be my guide moving me through many wordls painting cafes, restuaurants, hostels, and guesthouses.</EditableText>
        <EditableText id="murals.intro.end" tag="p" class="murals-intro__copy-end">enjoy the journey</EditableText>
      </div>
    </section>

    <!-- Free-positioning canvas. Tiles are SSR'd with cqw units so the
         layout scales with the canvas width — no client-side math
         needed for first paint. JS hydrates afterward to handle realtime
         updates + the editor. -->
    <div class="murals-canvas-wrap">
      <section
        class="murals-canvas"
        data-mural-canvas
        aria-label="murals"
        style={`height: ${maxBottom > 0 ? `${maxBottom + 8}cqw` : "800px"};`}
      >
        {ssrTiles.map((t) => {
          const href = autoHref(t);
          const style = tileStyle(t);
          const img = (
            <div class="mural-tile__inner">
              <img
                class="mural-tile__img"
                src={transformedSrc(t.src)}
                alt={t.alt || ""}
                loading="lazy"
                decoding="async"
                style={t.object_position ? `object-position:${t.object_position}` : ""}
                draggable={false}
              />
            </div>
          );
          const label = t.label ? (
            <span class="mural-tile__label">
              {t.label}
              {t.href || href ? <span class="mural-tile__label-arrow">{">"}</span> : null}
            </span>
          ) : null;
          return href ? (
            <a class="mural-tile" data-id={t.id} href={href} style={style}>
              {img}
              {label}
            </a>
          ) : (
            <div class="mural-tile" data-id={t.id} style={style}>
              {img}
              {label}
            </div>
          );
        })}
        {ssrTiles.length === 0 && (
          <div class="murals-canvas__loading" data-loading>loading…</div>
        )}
      </section>
    </div>
  </div>

  <script>
    import { initMuralsBoard } from "../../scripts/murals-board";
    initMuralsBoard("home");
  </script>
</BaseLayout>

<style>
  :global(body.is-bare) {
    background: #000;
    color: #fff;
    font-family: var(--font-sans);
  }

  .murals-page {
    background: #000;
    color: #fff;
    min-height: 100vh;
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    padding: clamp(var(--sp-4), 5vw, var(--sp-8)) clamp(var(--sp-3), 4vw, var(--sp-8)) var(--sp-16);
    position: relative;
  }

  .murals-page__back {
    position: absolute;
    top: clamp(var(--sp-3), 4vw, var(--sp-6));
    left: clamp(var(--sp-3), 4vw, var(--sp-6));
    color: #fff;
    font-family: Arial, "Arial Hebrew", "Helvetica Neue", sans-serif;
    font-weight: 700;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1;
    opacity: 0.85;
    transition: opacity var(--duration-fast) var(--ease-out);
    z-index: 5;
  }

  .murals-page__back:hover { opacity: 1; }

  /* ---------- Intro ---------- */
  .murals-intro {
    max-width: 720px;
    margin: 0 auto var(--sp-8);
  }
  .murals-intro__title { margin: 0 0 var(--sp-4); line-height: 0; }
  .murals-intro__title-img {
    width: clamp(220px, 32vw, 360px);
    height: auto;
    filter: invert(1);
  }
  .murals-intro__journey {
    margin: 0 0 var(--sp-5);
    font-family: "Times New Roman", Times, serif;
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.6rem, 3.2vw, 2.4rem);
    color: #fff;
  }
  .murals-intro__copy {
    font-family: "Times New Roman", Times, serif;
    font-size: clamp(1.05rem, 1.4vw, 1.2rem);
    font-weight: 400;
    line-height: 1.6;
    color: #fff;
    max-width: 40ch;
  }
  .murals-intro__copy p { margin: 0 0 var(--sp-3); }
  .murals-intro__copy-end { margin-top: var(--sp-4) !important; }

  /* ---------- Free-positioning canvas ----------
     Tile + handle styles live in murals-board.ts (JS-injected, global)
     because Astro's scoped CSS doesn't reach DOM created dynamically.
     The canvas itself sets container-type: inline-size so tiles' cqw
     units track its width — uniform layout across every viewport, no
     horizontal scroll. */
  .murals-canvas-wrap {
    position: relative;
    /* Full-bleed breakout: pull the wrap outside the .murals-page
       horizontal padding so tiles render edge-to-edge of the viewport.
       Same proportional layout, just bigger. */
    margin-left: calc(-1 * clamp(var(--sp-3), 4vw, var(--sp-8)));
    margin-right: calc(-1 * clamp(var(--sp-3), 4vw, var(--sp-8)));
  }
  .murals-canvas {
    position: relative;
    width: 100%;
    container-type: inline-size;
    min-height: 80vh;
  }

  .murals-canvas__loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #555;
    font-family: monospace;
  }
</style>
