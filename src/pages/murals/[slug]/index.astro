---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { allSlugs, tilesFor, type MuralTile } from "../../../lib/mural-tiles";
import "../../../styles/mural-tiles.css";

// Pre-render every distinct page slug in the committed tile snapshot, and
// ALSO any slug that can be derived from a tile's label — a tile labelled
// "nepal" materialises /murals/nepal/.
export function getStaticPaths() {
  const slugs = allSlugs();
  return slugs.length > 0
    ? slugs.map((slug) => ({ params: { slug } }))
    : [{ params: { slug: "placeholder" } }];
}

const { slug } = Astro.params as { slug: string };
const displayTitle = (slug || "").replace(/[-_]+/g, " ");

// Tiles for this sub-page come from the committed snapshot: rows authored
// on this page slug plus rows whose label slugifies to it.
const ssrTiles: MuralTile[] = tilesFor(slug);

function autoHref(t: MuralTile): string | null {
  if (t.href) return t.href;
  if (!t.label) return null;
  const s = t.label
    .toLowerCase()
    .normalize("NFD")
    .replace(/[̀-ͯ]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
  return s ? `/murals/${s}/` : null;
}
const _rawMinX = ssrTiles.length ? Math.min(...ssrTiles.map(t => t.x)) : 0;
const _rawMaxX = ssrTiles.length ? Math.max(...ssrTiles.map(t => t.x + t.w)) : 100;
const _rawMinY = ssrTiles.length ? Math.min(...ssrTiles.map(t => t.y)) : 0;
const _fitScale = (_rawMaxX - _rawMinX) > 0 ? 100 / (_rawMaxX - _rawMinX) : 1;

function fitX(x: number): number { return (x - _rawMinX) * _fitScale; }
function fitY(y: number): number { return (y - _rawMinY) * _fitScale; }
function fitS(s: number): number { return s * _fitScale; }

const maxBottom = (ssrTiles.reduce((m, t) => Math.max(m, fitY(t.y) + fitS(t.h)), 0) || 100) + 4;

function tileStyle(t: MuralTile): string {
  return [
    `left:${fitX(t.x)}%`,
    `top:${(fitY(t.y) / maxBottom) * 100}%`,
    `width:${fitS(t.w)}%`,
    `height:${(fitS(t.h) / maxBottom) * 100}%`,
    `z-index:${t.order_idx || 0}`,
    t.rotation ? `transform:rotate(${t.rotation}deg)` : "",
  ].filter(Boolean).join(";");
}
---

<BaseLayout title={`${displayTitle} — murals — shalagh quinn`} bare>
  <div class="murals-page">
    <a href="/murals/" class="murals-page__back" aria-label="back to murals">
      <span aria-hidden="true">&lt;</span>
    </a>

    <header class="murals-sub-header">
      <h1 class="murals-sub-title">{displayTitle}</h1>
    </header>

    <div class="murals-canvas-wrap">
      <section
        class="murals-canvas"
        data-mural-canvas
        aria-label={displayTitle}
        style={`aspect-ratio: 100 / ${maxBottom};`}
      >
        {ssrTiles.map((t) => {
          const href = autoHref(t);
          const style = tileStyle(t);
          const img = (
            <div class="mural-tile__inner">
              <img
                class="mural-tile__img"
                src={t.src}
                alt={t.alt || ""}
                loading="lazy"
                decoding="async"
                style={t.object_position ? `object-position:${t.object_position}` : ""}
                draggable={false}
              />
            </div>
          );
          const label = t.label ? (
            <span class="mural-tile__label">
              {t.label}
              {t.href || href ? <span class="mural-tile__label-arrow">{">"}</span> : null}
            </span>
          ) : null;
          return href ? (
            <a class="mural-tile" data-id={t.id} href={href} style={style}>
              {img}
              {label}
            </a>
          ) : (
            <div class="mural-tile" data-id={t.id} style={style}>
              {img}
              {label}
            </div>
          );
        })}
        {ssrTiles.length === 0 && (
          <div class="murals-canvas__loading" data-loading>loading…</div>
        )}
      </section>
    </div>
  </div>

</BaseLayout>

<style>
  :global(body.is-bare) {
    background: #000;
    color: #fff;
    font-family: var(--font-sans);
  }

  .murals-page {
    background: #000;
    color: #fff;
    min-height: 100vh;
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    padding: clamp(var(--sp-4), 5vw, var(--sp-8)) clamp(var(--sp-3), 4vw, var(--sp-8)) var(--sp-16);
    position: relative;
  }

  .murals-page__back {
    position: absolute;
    top: clamp(var(--sp-3), 4vw, var(--sp-6));
    left: clamp(var(--sp-3), 4vw, var(--sp-6));
    color: #fff;
    font-family: Arial, "Arial Hebrew", "Helvetica Neue", sans-serif;
    font-weight: 700;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1;
    opacity: 0.85;
    transition: opacity var(--duration-fast) var(--ease-out);
    z-index: 5;
  }

  .murals-page__back:hover { opacity: 1; }

  .murals-sub-header {
    max-width: 1280px;
    margin: 0 auto var(--sp-6);
    padding-top: var(--sp-4);
    text-align: center;
  }

  .murals-sub-title {
    margin: 0;
    color: #fff;
    font-family: "Caveat", "Patrick Hand", cursive;
    font-weight: 700;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1;
    text-transform: lowercase;
  }

  .murals-canvas-wrap {
    position: relative;
    /* Full-bleed: tiles span edge-to-edge of the viewport. */
    margin-left: calc(-1 * clamp(var(--sp-3), 4vw, var(--sp-8)));
    margin-right: calc(-1 * clamp(var(--sp-3), 4vw, var(--sp-8)));
  }
  .murals-canvas {
    position: relative;
    width: 100%;
    /* No min-height — would override the aspect-ratio rule and
       stretch every tile vertically, which read as cropping. */
  }
  .murals-canvas__loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #555;
    font-family: monospace;
  }
</style>
