---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { supabase } from "../../../lib/supabase";

// Pre-render every distinct page slug that exists in mural_tiles, and ALSO
// any slug that can be derived from a tile's label. That way the editor user
// can label a tile "nepal", commit, and on the next deploy /murals/nepal/
// exists — without having to first move tiles into a page='nepal' bucket.
//
// slugify is defined inside getStaticPaths because Astro extracts that
// function to its own build-time bundle; top-level helpers in the
// frontmatter aren't carried over.
export async function getStaticPaths() {
  const slugify = (s: string | null | undefined): string => {
    if (!s) return "";
    return s
      .toLowerCase()
      .normalize("NFD")
      .replace(/[̀-ͯ]/g, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/(^-|-$)/g, "");
  };

  try {
    const { data, error } = await supabase
      .from("mural_tiles")
      .select("page, label");
    if (error) console.warn("[murals/[slug]] getStaticPaths supabase error:", error);
    const slugs = new Set<string>();
    for (const row of (data || []) as Array<{ page: string | null; label: string | null }>) {
      if (row.page && row.page !== "home") slugs.add(row.page);
      const fromLabel = slugify(row.label);
      if (fromLabel) slugs.add(fromLabel);
    }
    console.log(`[murals/[slug]] getStaticPaths slugs: ${[...slugs].join(", ") || "(none)"}`);
    if (slugs.size > 0) return Array.from(slugs).map((slug) => ({ params: { slug } }));
  } catch (e) {
    console.warn("[murals/[slug]] Supabase unreachable at build time; using placeholder", e);
  }
  return [{ params: { slug: "placeholder" } }];
}

const { slug } = Astro.params as { slug: string };
const displayTitle = (slug || "").replace(/[-_]+/g, " ");

// Build-time tile fetch for this sub-page (both rows where page=<slug>
// AND rows whose label slugifies to <slug>, matching what getStaticPaths
// derived). SSR them so the page paints instantly.
type SsrTile = {
  id: string; src: string; alt: string;
  x: number; y: number; w: number; h: number;
  rotation: number; object_position: string;
  label: string | null; href: string | null;
  order_idx: number; page: string;
};
let ssrTiles: SsrTile[] = [];
try {
  // First take rows that were authored against this page slug, then add
  // any rows whose label slugifies to it (the dynamic-from-label
  // contract). Dedupe by id.
  const seen = new Set<string>();
  const acc: SsrTile[] = [];
  const slugify2 = (s: string | null | undefined): string => {
    if (!s) return "";
    return s
      .toLowerCase()
      .normalize("NFD")
      .replace(/[̀-ͯ]/g, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/(^-|-$)/g, "");
  };

  const { data: byPage } = await supabase
    .from("mural_tiles")
    .select("*")
    .eq("page", slug)
    .order("y", { ascending: true })
    .order("x", { ascending: true })
    .order("order_idx", { ascending: true });
  for (const r of (byPage || []) as SsrTile[]) {
    if (!seen.has(r.id)) { seen.add(r.id); acc.push(r); }
  }
  const { data: all } = await supabase
    .from("mural_tiles")
    .select("*");
  for (const r of (all || []) as SsrTile[]) {
    if (slugify2(r.label) === slug && !seen.has(r.id)) {
      seen.add(r.id); acc.push(r);
    }
  }
  ssrTiles = acc;
} catch (e) {
  console.warn("[murals/[slug]] Supabase unreachable at build time; falling back to JS render", e);
}

function autoHref(t: SsrTile): string | null {
  if (t.href) return t.href;
  if (!t.label) return null;
  const s = t.label
    .toLowerCase()
    .normalize("NFD")
    .replace(/[̀-ͯ]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");
  return s ? `/murals/${s}/` : null;
}
function transformedSrc(src: string | null | undefined): string {
  return src || "";
}
function tileStyle(t: SsrTile): string {
  return [
    `left:${t.x}cqw`,
    `top:${t.y}cqw`,
    `width:${t.w}cqw`,
    `height:${t.h}cqw`,
    `z-index:${t.order_idx || 0}`,
    t.rotation ? `transform:rotate(${t.rotation}deg)` : "",
  ].filter(Boolean).join(";");
}
const maxBottom = ssrTiles.reduce((m, t) => Math.max(m, t.y + t.h), 0);
---

<BaseLayout title={`${displayTitle} — murals — shalagh quinn`} bare>
  <div class="murals-page">
    <a href="/murals/" class="murals-page__back" aria-label="back to murals">
      <span aria-hidden="true">&lt;</span>
    </a>

    <header class="murals-sub-header">
      <h1 class="murals-sub-title" data-editable-text={`murals.${slug}.title`}>{displayTitle}</h1>
    </header>

    <div class="murals-canvas-wrap">
      <section
        class="murals-canvas"
        data-mural-canvas
        aria-label={displayTitle}
        style={`height: ${maxBottom > 0 ? `${maxBottom + 8}cqw` : "800px"};`}
      >
        {ssrTiles.map((t) => {
          const href = autoHref(t);
          const style = tileStyle(t);
          const img = (
            <div class="mural-tile__inner">
              <img
                class="mural-tile__img"
                src={transformedSrc(t.src)}
                alt={t.alt || ""}
                loading="lazy"
                decoding="async"
                style={t.object_position ? `object-position:${t.object_position}` : ""}
                draggable={false}
              />
            </div>
          );
          const label = t.label ? (
            <span class="mural-tile__label">
              {t.label}
              {t.href || href ? <span class="mural-tile__label-arrow">{">"}</span> : null}
            </span>
          ) : null;
          return href ? (
            <a class="mural-tile" data-id={t.id} href={href} style={style}>
              {img}
              {label}
            </a>
          ) : (
            <div class="mural-tile" data-id={t.id} style={style}>
              {img}
              {label}
            </div>
          );
        })}
        {ssrTiles.length === 0 && (
          <div class="murals-canvas__loading" data-loading>loading…</div>
        )}
      </section>
    </div>
  </div>

  <script define:vars={{ slug }}>
    (window as any).__muralSlug = slug;
  </script>
  <script>
    import { initMuralsBoard } from "../../../scripts/murals-board";
    initMuralsBoard((window as any).__muralSlug || "home");
  </script>
</BaseLayout>

<style>
  :global(body.is-bare) {
    background: #000;
    color: #fff;
    font-family: var(--font-sans);
  }

  .murals-page {
    background: #000;
    color: #fff;
    min-height: 100vh;
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    padding: clamp(var(--sp-4), 5vw, var(--sp-8)) clamp(var(--sp-3), 4vw, var(--sp-8)) var(--sp-16);
    position: relative;
  }

  .murals-page__back {
    position: absolute;
    top: clamp(var(--sp-3), 4vw, var(--sp-6));
    left: clamp(var(--sp-3), 4vw, var(--sp-6));
    color: #fff;
    font-family: Arial, "Arial Hebrew", "Helvetica Neue", sans-serif;
    font-weight: 700;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1;
    opacity: 0.85;
    transition: opacity var(--duration-fast) var(--ease-out);
    z-index: 5;
  }

  .murals-page__back:hover { opacity: 1; }

  .murals-sub-header {
    max-width: 1280px;
    margin: 0 auto var(--sp-6);
    padding-top: var(--sp-4);
    text-align: center;
  }

  .murals-sub-title {
    margin: 0;
    color: #fff;
    font-family: "Caveat", "Patrick Hand", cursive;
    font-weight: 700;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1;
    text-transform: lowercase;
  }

  .murals-canvas-wrap {
    position: relative;
    /* Full-bleed: tiles span edge-to-edge of the viewport. */
    margin-left: calc(-1 * clamp(var(--sp-3), 4vw, var(--sp-8)));
    margin-right: calc(-1 * clamp(var(--sp-3), 4vw, var(--sp-8)));
  }
  .murals-canvas {
    position: relative;
    width: 100%;
    container-type: inline-size;
    min-height: 80vh;
  }
  .murals-canvas__loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #555;
    font-family: monospace;
  }
</style>
