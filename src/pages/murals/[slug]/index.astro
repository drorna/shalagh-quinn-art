---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { supabase } from "../../../lib/supabase";

// Pre-render every distinct page slug that exists in mural_tiles, and ALSO
// any slug that can be derived from a tile's label. That way the editor user
// can label a tile "nepal", commit, and on the next deploy /murals/nepal/
// exists — without having to first move tiles into a page='nepal' bucket.
//
// slugify is defined inside getStaticPaths because Astro extracts that
// function to its own build-time bundle; top-level helpers in the
// frontmatter aren't carried over.
export async function getStaticPaths() {
  const slugify = (s: string | null | undefined): string => {
    if (!s) return "";
    return s
      .toLowerCase()
      .normalize("NFD")
      .replace(/[̀-ͯ]/g, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/(^-|-$)/g, "");
  };

  try {
    const { data, error } = await supabase
      .from("mural_tiles")
      .select("page, label");
    if (error) console.warn("[murals/[slug]] getStaticPaths supabase error:", error);
    const slugs = new Set<string>();
    for (const row of (data || []) as Array<{ page: string | null; label: string | null }>) {
      if (row.page && row.page !== "home") slugs.add(row.page);
      const fromLabel = slugify(row.label);
      if (fromLabel) slugs.add(fromLabel);
    }
    console.log(`[murals/[slug]] getStaticPaths slugs: ${[...slugs].join(", ") || "(none)"}`);
    if (slugs.size > 0) return Array.from(slugs).map((slug) => ({ params: { slug } }));
  } catch (e) {
    console.warn("[murals/[slug]] Supabase unreachable at build time; using placeholder", e);
  }
  return [{ params: { slug: "placeholder" } }];
}

const { slug } = Astro.params as { slug: string };
const displayTitle = (slug || "").replace(/[-_]+/g, " ");
---

<BaseLayout title={`${displayTitle} — murals — shalagh quinn`} bare>
  <div class="murals-page">
    <a href="/murals/" class="murals-page__back" aria-label="back to murals">
      <span aria-hidden="true">&lt;</span>
    </a>

    <header class="murals-sub-header">
      <h1 class="murals-sub-title" data-editable-text={`murals.${slug}.title`}>{displayTitle}</h1>
    </header>

    <section class="murals-canvas" data-mural-canvas aria-label={displayTitle}>
      <div class="murals-canvas__loading" data-loading>loading…</div>
    </section>
  </div>

  <script define:vars={{ slug }}>
    (window as any).__muralSlug = slug;
  </script>
  <script>
    import { initMuralsBoard } from "../../../scripts/murals-board";
    import { initTextEditor } from "../../../scripts/text-editor";
    initMuralsBoard((window as any).__muralSlug || "home");
    initTextEditor();
  </script>
</BaseLayout>

<style>
  :global(body.is-bare) {
    background: #000;
    color: #fff;
    font-family: var(--font-sans);
  }

  .murals-page {
    background: #000;
    color: #fff;
    min-height: 100vh;
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    padding: clamp(var(--sp-4), 5vw, var(--sp-8)) clamp(var(--sp-3), 4vw, var(--sp-8)) var(--sp-16);
    position: relative;
  }

  .murals-page__back {
    position: absolute;
    top: clamp(var(--sp-3), 4vw, var(--sp-6));
    left: clamp(var(--sp-3), 4vw, var(--sp-6));
    color: #fff;
    font-family: Arial, "Arial Hebrew", "Helvetica Neue", sans-serif;
    font-weight: 700;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 1;
    opacity: 0.85;
    transition: opacity var(--duration-fast) var(--ease-out);
    z-index: 5;
  }

  .murals-page__back:hover { opacity: 1; }

  .murals-sub-header {
    max-width: 1280px;
    margin: 0 auto var(--sp-6);
    padding-top: var(--sp-4);
    text-align: center;
  }

  .murals-sub-title {
    margin: 0;
    color: #fff;
    font-family: "Caveat", "Patrick Hand", cursive;
    font-weight: 700;
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    line-height: 1;
    text-transform: lowercase;
  }

  .murals-canvas {
    position: relative;
    max-width: 1280px;
    margin: 0 auto;
    min-height: 80vh;
  }
  .murals-canvas__loading {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #555;
    font-family: monospace;
  }
</style>
