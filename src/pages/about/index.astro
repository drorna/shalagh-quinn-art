---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

// July 2026 about design v2: back arrow + handwritten shalagh header,
// full-bleed self-portrait photo, then the story from Obsidian.
import selfPortrait from "../../assets/images/about/self-portrait.jpg";
import handShalagh from "../../assets/images/about/hand-shalagh.png";

// Content lives in shalagh-quinn-art/pages/about.md so Sheila edits it
// in Obsidian — layout here, words there. The browser editor's
// per-element overrides (site_text) still apply on top.
const entry = await getEntry("pages", "about");
const f = entry?.data ?? { title: "about" };
const body = entry?.body ?? "";
const paragraphs = body
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);

// Render Obsidian-style *emphasis* as real italics. Text is escaped
// first so only the asterisk markers become markup.
const esc = (s: string) =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const emphasize = (p: string) =>
  esc(p).replace(/\*([^*\n][^*]*)\*/g, "<em>$1</em>");
---

<BaseLayout title="about — shalagh quinn" bare>
  <div class="sheet">
    <header class="about-top">
      <a href="/" class="about-top__back" aria-label="back home">
        <span aria-hidden="true">&lt;</span>
      </a>
      <h1 class="about-top__name">
        <Image
          src={handShalagh}
          alt="Shalagh"
          widths={[300, 439]}
          sizes="(min-width: 720px) 280px, 39vw"
          quality={92}
          loading="eager"
          class="about-top__name-img"
        />
      </h1>
    </header>

    <article class="about">
      <Image
        src={selfPortrait}
        alt="Shalagh looking over her shoulder, covered in paint"
        widths={[500, 720, 899]}
        sizes="(min-width: 720px) 720px, 100vw"
        quality={88}
        loading="eager"
        class="about__photo"
      />

      <div class="about__inner">
        {f.stanza && (
          <p class="about__pron" data-editable-text="about.story.stanza">{f.stanza.trim()}</p>
        )}

        <div class="about__story">
          {paragraphs.map((p, i) => (
            <p data-editable-text={`about.story.p${i + 1}`} set:html={emphasize(p)} />
          ))}
        </div>
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  :global(body.is-bare) {
    background: #fff;
    color: #000;
    font-family: Arial, "Helvetica Neue", sans-serif;
  }

  .sheet {
    --u: calc(min(100vw, 720px) / 1080);
    width: min(100vw, 720px);
    margin: 0 auto;
    min-height: 100vh;
    background: #fff;
    color: #000;
    -webkit-font-smoothing: antialiased;
    padding-bottom: calc(220 * var(--u));
  }

  /* ---------- Header: < left, handwritten shalagh right ---------- */

  .about-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    padding: calc(36 * var(--u)) calc(30 * var(--u)) 0 calc(36 * var(--u));
  }

  .about-top__back {
    color: #000;
    font-family: Arial, "Helvetica Neue", sans-serif;
    font-weight: 700;
    font-size: calc(50 * var(--u));
    line-height: 1;
    text-decoration: none;
  }

  .about-top__name {
    margin: 0;
    line-height: 0;
  }

  .about-top__name-img {
    display: block;
    width: calc(420 * var(--u));
    height: auto;
  }

  /* ---------- Photo: full bleed ---------- */

  .about__photo {
    display: block;
    width: 100%;
    height: auto;
    margin-top: calc(50 * var(--u));
  }

  /* ---------- Text column ---------- */

  .about__inner {
    padding: 0 calc(93 * var(--u));
  }

  .about__pron {
    margin: calc(70 * var(--u)) 0 0;
    font-family: Arial, "Helvetica Neue", sans-serif;
    font-style: italic;
    font-weight: 700;
    font-size: calc(34 * var(--u));
    line-height: 1.2;
  }

  .about__story {
    margin-top: calc(60 * var(--u));
    font-family: "Times New Roman", Times, serif;
    font-size: calc(32 * var(--u));
    line-height: 1.55;
  }

  .about__story p {
    margin: 0 0 calc(44 * var(--u));
    /* Obsidian single linebreaks are real breaks in her stanzas —
       keep them (the editor applies the same rule to editable text). */
    white-space: pre-line;
  }

  .about__story em {
    font-style: italic;
  }
</style>
