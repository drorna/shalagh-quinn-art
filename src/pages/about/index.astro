---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

// Sheila painting a mural — the photo drorna picked for the July 2026
// about redesign (processed from "painting shay.png").
import paintingShay from "../../assets/images/about/painting-shay.jpg";

// Content lives in shalagh-quinn-art/pages/about.md so Sheila edits it
// in Obsidian. The browser editor's per-element overrides (site_text)
// still apply on top — markdown is the default, Supabase wins.
const entry = await getEntry("pages", "about");
const f = entry?.data ?? { title: "about" };
const body = entry?.body ?? "";
const paragraphs = body
  .split(/\n\s*\n/)
  .map((p) => p.trim())
  .filter(Boolean);

// Render Obsidian-style *emphasis* as real italics. Text is escaped
// first so only the asterisk markers become markup.
const esc = (s: string) =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const emphasize = (p: string) =>
  esc(p).replace(/\*([^*\n][^*]*)\*/g, "<em>$1</em>");
---

<!-- July 2026 about redesign — white sheet, black ink, photo on top,
     Times title + Arial bold-italic pronunciation, Times story with
     italic stanzas. Same --u proportional system as the home page. -->
<BaseLayout title="about — shalagh quinn" bare>
  <div class="sheet">
    <article class="about">
      <Image
        src={paintingShay}
        alt="Shalagh painting a mural"
        widths={[600, 900, 1200, 1402]}
        sizes="(min-width: 720px) 604px, 84vw"
        quality={88}
        loading="eager"
        class="about__photo"
      />

      <h1 class="about__title" data-editable-text="about.subtitle">{f.subtitle ?? "shalagh"}</h1>
      {f.stanza && (
        <p class="about__pron" data-editable-text="about.story.stanza">{f.stanza.trim()}</p>
      )}

      <div class="about__story">
        {paragraphs.map((p, i) => (
          <p data-editable-text={`about.story.p${i + 1}`} set:html={emphasize(p)} />
        ))}
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  :global(body.is-bare) {
    background: #fff;
    color: #000;
    font-family: Arial, "Helvetica Neue", sans-serif;
  }

  .sheet {
    --u: calc(min(100vw, 720px) / 1080);
    width: min(100vw, 720px);
    margin: 0 auto;
    min-height: 100vh;
    background: #fff;
    color: #000;
    -webkit-font-smoothing: antialiased;
    padding-bottom: calc(220 * var(--u));
    position: relative;
  }

  /* Content column shares the pill margins from home (x 79 → 984). */
  .about {
    padding: 0 calc(96 * var(--u)) 0 calc(79 * var(--u));
  }

  .about__photo {
    display: block;
    width: 100%;
    height: auto;
    margin-top: calc(130 * var(--u));
  }

  .about__title {
    margin: calc(100 * var(--u)) 0 0;
    font-family: "Times New Roman", Times, serif;
    font-weight: 400;
    font-size: calc(63 * var(--u));
    letter-spacing: 0.015em;
    line-height: 1.1;
    text-transform: lowercase;
  }

  .about__pron {
    margin: calc(22 * var(--u)) 0 0;
    font-family: Arial, "Helvetica Neue", sans-serif;
    font-style: italic;
    font-weight: 700;
    font-size: calc(40 * var(--u));
    line-height: 1.2;
    text-transform: lowercase;
  }

  .about__story {
    margin-top: calc(80 * var(--u));
    font-family: "Times New Roman", Times, serif;
    font-size: calc(36 * var(--u));
    line-height: 1.55;
  }

  .about__story p {
    margin: 0 0 calc(48 * var(--u));
    /* Obsidian single linebreaks are real breaks in her stanzas —
       keep them (the editor applies the same rule to editable text). */
    white-space: pre-line;
  }

  .about__story em {
    font-style: italic;
  }
</style>
