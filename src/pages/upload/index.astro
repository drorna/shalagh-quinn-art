---
import { getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

// Form submissions go through FormSubmit (no account required).
// Visitors are redirected to /thanks/ after upload.
const FORM_ENDPOINT = "https://formsubmit.co/shalaghquinns@gmail.com";
const THANK_YOU_URL = "https://shalagh.com/thanks/";

// Page copy lives in the vault-root Obsidian note "Upload.md" — a plain
// note with no frontmatter, same pattern as Inside Time.md. Blank lines
// split paragraphs.
const uploadNote = await getEntry("notes", "upload");
const uploadCopy = uploadNote?.body?.trim()
  ? uploadNote.body.trim().split(/\n\s*\n/)
  : [
      "you can upload a photo of your piece so it can be shared on social media. tagging is optional.",
    ];
---

<!-- Styled in the home page's unified language: white sheet, black ink,
     one rounded pill box holding the whole form. Same --u proportional
     unit system as the home page (1080-unit artboard). -->
<BaseLayout title="upload — shalagh quinn" bare>
  <div class="sheet">
    <main class="sheet-main">
      <section class="pill">
        <div class="pill__head">
          <h1 class="pill__label" data-editable-text="upload.title">hi —</h1>
        </div>
        <div class="pill__content">
          {uploadCopy.map((p) => (
            <p class="pill__copy">{p}</p>
          ))}

          <form
            class="upload-form"
            action={FORM_ENDPOINT}
            method="POST"
            enctype="multipart/form-data"
          >
            <input type="hidden" name="_subject" value="New upload from shalagh.com/upload" />
            <input type="hidden" name="_template" value="table" />
            <input type="hidden" name="_captcha" value="false" />
            <input type="hidden" name="_next" value={THANK_YOU_URL} />

            <label class="upload-form__field">
              <span class="upload-form__label" data-editable-text="upload.field.name">your name (optional)</span>
              <input type="text" name="Name" autocomplete="name" />
            </label>

            <label class="upload-form__field">
              <span class="upload-form__label" data-editable-text="upload.field.tag">tag — instagram handle, etc. (optional)</span>
              <input type="text" name="Tag" placeholder="@yourhandle" />
            </label>

            <div class="upload-form__field">
              <span class="upload-form__label" data-editable-text="upload.field.photo">photo</span>
              <div class="upload-form__filebox">
                <label class="upload-form__filebtn" for="upload-camera">
                  take a photo
                  <input
                    id="upload-camera"
                    type="file"
                    name="Photo (camera)"
                    accept="image/*"
                    capture="environment"
                    hidden
                  />
                </label>
                <label class="upload-form__filebtn" for="upload-gallery">
                  choose from gallery
                  <input
                    id="upload-gallery"
                    type="file"
                    name="Photo (gallery)"
                    accept="image/*"
                    hidden
                  />
                </label>
              </div>
              <p class="upload-form__filename" id="upload-filename" aria-live="polite"></p>
            </div>

            <button type="submit" class="upload-form__submit">
              <span data-editable-text="upload.submit">upload</span>
              <span class="upload-form__submit-arrow" aria-hidden="true">&gt;</span>
            </button>
          </form>
        </div>
      </section>
    </main>
  </div>

  <script>
    const inputs = document.querySelectorAll<HTMLInputElement>(
      '#upload-camera, #upload-gallery'
    );
    const nameEl = document.getElementById('upload-filename');
    inputs.forEach((inp) => {
      inp.addEventListener('change', () => {
        const f = inp.files?.[0];
        if (f && nameEl) {
          nameEl.textContent = `selected: ${f.name}`;
        }
      });
    });
  </script>
</BaseLayout>

<style>
  /* =========================================================
     Unified site sheet — mirrors the home page's system.
     ========================================================= */

  :global(body.is-bare) {
    background: #fff;
    color: #000;
    font-family: Arial, "Helvetica Neue", sans-serif;
  }

  .sheet {
    --u: calc(min(100vw, 720px) / 1080);
    width: min(100vw, 720px);
    margin: 0 auto;
    min-height: 100vh;
    background: #fff;
    color: #000;
    -webkit-font-smoothing: antialiased;
    padding-bottom: calc(220 * var(--u));
  }

  /* ---------- Pill box ---------- */

  .sheet-main {
    margin-top: calc(140 * var(--u));
    padding: 0 calc(96 * var(--u)) 0 calc(79 * var(--u));
  }

  .pill {
    border: max(2px, calc(3 * var(--u))) solid #000;
    border-radius: calc(48 * var(--u));
    background: #fff;
  }

  .pill__head {
    display: flex;
    align-items: center;
    min-height: calc(102.5 * var(--u));
    padding: 0 calc(66 * var(--u));
  }

  .pill__label {
    margin: 0;
    font-family: Arial, "Helvetica Neue", sans-serif;
    font-style: italic;
    font-weight: 400;
    font-size: calc(66.5 * var(--u));
    line-height: 1;
    position: relative;
    top: calc(-3 * var(--u));
  }

  .pill__content {
    padding: calc(2 * var(--u)) calc(88 * var(--u)) calc(70 * var(--u))
      calc(73 * var(--u));
  }

  .pill__copy {
    margin: 0 0 calc(28 * var(--u));
    font-family: "Times New Roman", Times, serif;
    font-style: italic;
    font-size: calc(40 * var(--u));
    line-height: 1.5;
  }

  .pill__copy:last-of-type {
    margin-bottom: calc(70 * var(--u));
  }

  /* ---------- Form ---------- */

  .upload-form {
    display: flex;
    flex-direction: column;
    gap: calc(60 * var(--u));
  }

  .upload-form__field {
    display: flex;
    flex-direction: column;
    gap: calc(14 * var(--u));
  }

  .upload-form__label {
    font-family: "Times New Roman", Times, serif;
    font-style: italic;
    font-size: calc(36 * var(--u));
    line-height: 1.3;
    opacity: 0.7;
  }

  .upload-form input[type="text"] {
    border: 0;
    border-bottom: max(1px, calc(2 * var(--u))) solid #000;
    background: transparent;
    padding: calc(12 * var(--u)) 0;
    font-family: "Times New Roman", Times, serif;
    font-size: calc(46.6 * var(--u));
    color: #000;
    border-radius: 0;
  }

  .upload-form input[type="text"]:focus {
    outline: 0;
    border-bottom-width: max(2px, calc(3 * var(--u)));
  }

  .upload-form input[type="text"]::placeholder {
    color: #000;
    opacity: 0.35;
  }

  .upload-form__filebox {
    display: flex;
    flex-wrap: wrap;
    gap: calc(24 * var(--u));
    margin-top: calc(8 * var(--u));
  }

  /* Mini pills — same rounded-border language as the nav boxes. */
  .upload-form__filebtn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: calc(22 * var(--u)) calc(44 * var(--u));
    border: max(2px, calc(3 * var(--u))) solid #000;
    border-radius: calc(48 * var(--u));
    color: #000;
    font-family: Arial, "Helvetica Neue", sans-serif;
    font-style: italic;
    font-size: calc(40 * var(--u));
    line-height: 1;
    cursor: pointer;
    background: #fff;
  }

  .upload-form__filebtn:active {
    background: #000;
    color: #fff;
  }

  .upload-form__filename {
    margin: calc(10 * var(--u)) 0 0;
    font-family: "Times New Roman", Times, serif;
    font-style: italic;
    font-size: calc(36 * var(--u));
    opacity: 0.7;
    min-height: 1.2em;
  }

  /* Submit reads like an offerings row: Times text + > */
  .upload-form__submit {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    width: 100%;
    background: transparent;
    border: none;
    padding: 0;
    font-family: "Times New Roman", Times, serif;
    font-size: calc(46.6 * var(--u));
    line-height: calc(72 * var(--u));
    color: #000;
    cursor: pointer;
    text-align: left;
  }

  .upload-form__submit-arrow {
    font-family: "Times New Roman", Times, serif;
  }
</style>
