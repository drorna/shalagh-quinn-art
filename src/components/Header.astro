---
import { Image } from "astro:assets";
import homeCover from "../assets/images/home-cover.jpg";

const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";
const contactHref = isHome ? "#contact" : "/#contact";
---

<header
  class:list={["site-header", { "site-header--home": isHome }]}
  data-header
>
  <div class="container site-header__inner">
    <div class="site-header__brand-block">
      {isHome && (
        <div class="site-header__logo">
          <Image
            src={homeCover}
            alt=""
            widths={[280, 420, 560, 720]}
            sizes="(min-width: 1100px) 460px, (min-width: 700px) 36vw, 55vw"
            quality={92}
            loading="eager"
            class="site-header__logo-img"
          />
        </div>
      )}
      <a href="/" class="site-header__brand" aria-label="shalagh — home">
        <span class="site-header__name">shalagh</span>
      </a>
    </div>

    <nav class="site-header__nav" aria-label="Primary">
      <a href="/murals/" class="site-header__nav-link">murals</a>
      <a href="/portraits/" class="site-header__nav-link">portraits</a>
      <a href="/prints/" class="site-header__nav-link">prints</a>
      <a href="/about/" class="site-header__nav-link">about</a>
      <a href={contactHref} class="site-header__nav-link">contact</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 30;
    background: var(--color-paper);
    padding-block: var(--sp-4) var(--sp-3);
  }

  .site-header--home {
    padding-block: var(--sp-6) var(--sp-4);
  }

  .site-header__inner {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--sp-4);
  }

  .site-header__brand-block {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--sp-3);
    min-width: 0;
    flex: 0 1 auto;
  }

  /* Logo painting — home only.
     aspect-ratio container + cover + radial mask fades paper edges
     into the page so it reads as a drawing on paper, not photo-on-photo. */
  .site-header__logo {
    width: clamp(240px, 35vw, 460px);
    aspect-ratio: 3 / 4;
    overflow: hidden;
    line-height: 0;
  }

  .site-header__logo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    -webkit-mask-image: radial-gradient(ellipse 78% 88% at 50% 50%, #000 55%, transparent 100%);
    mask-image: radial-gradient(ellipse 78% 88% at 50% 50%, #000 55%, transparent 100%);
    mix-blend-mode: multiply;
  }

  /* Name */
  .site-header__brand {
    display: inline-flex;
    align-items: center;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .site-header__brand:hover {
    opacity: 0.7;
  }

  .site-header__name {
    font-family: var(--font-serif);
    font-weight: 400;
    font-style: normal;
    color: var(--color-ink);
    letter-spacing: -0.01em;
    line-height: 0.9;
    font-size: clamp(2rem, 5vw, 3rem);
  }

  .site-header--home .site-header__name {
    font-size: clamp(3rem, 10vw, 7.5rem);
  }

  /* Nav — vertical italic list, right-aligned, baseline-aligned with "shalagh" */
  .site-header__nav {
    display: flex !important;
    flex-direction: column !important;
    align-items: flex-end;
    gap: 0;
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(0.95rem, 1.3vw, 1.25rem);
    color: var(--color-ink);
    flex: 0 0 auto;
    line-height: 1.4;
  }

  .site-header--home .site-header__nav {
    font-size: clamp(1rem, 1.5vw, 1.4rem);
  }

  .site-header__nav-link {
    display: block;
    position: relative;
    padding-block: 1px;
    line-height: 1.4;
    text-align: right;
  }

  .site-header__nav-link::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: var(--color-ink);
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .site-header__nav-link:hover::after {
    transform: scaleX(1);
  }
</style>
