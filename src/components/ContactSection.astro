---
// Form submissions go through FormSubmit (no account required).
// On the FIRST submission, FormSubmit emails RECIPIENT_EMAIL with an
// activation link that must be clicked once to confirm the routing.
// Visitors are redirected to /thanks/ after a successful submission.
const FORM_ENDPOINT = "https://formsubmit.co/shalaghquinns@gmail.com";
const RECIPIENT_EMAIL = "shalaghquinns@gmail.com";
const THANK_YOU_URL = "https://shalagh.com/thanks/";
---

<section class="contact" id="contact" aria-labelledby="contact-title">
  <div class="container contact__inner">
    <header class="contact__head reveal">
      <h2 id="contact-title" class="contact__title">contact</h2>
      <p class="contact__lede">
        for mural inquiries, commissions, and conversations &mdash;
      </p>

      <ul class="contact__direct">
        <li>
          <span class="contact__direct-label">email</span>
          <a href={`mailto:${RECIPIENT_EMAIL}`}>{RECIPIENT_EMAIL}</a>
        </li>
        <li>
          <span class="contact__direct-label">instagram</span>
          <a href="https://instagram.com/shalagh" target="_blank" rel="noopener noreferrer">@shalagh</a>
        </li>
      </ul>
    </header>

    <form class="contact__form reveal" action={FORM_ENDPOINT} method="POST">
      <input type="hidden" name="_subject" value="New inquiry from your website — shalaghquinn" />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_captcha" value="false" />
      <input type="hidden" name="_next" value={THANK_YOU_URL} />
      <input type="hidden" name="_autoresponse" value="Thank you for reaching out — I've received your message and will be in touch soon. — Shalagh" />

      <div class="contact__row">
        <label class="contact__field">
          <span class="contact__label">name</span>
          <input type="text" name="Name" required autocomplete="name" />
        </label>
        <label class="contact__field">
          <span class="contact__label">email</span>
          <input type="email" name="Email" required autocomplete="email" />
        </label>
      </div>

      <div class="contact__row">
        <label class="contact__field">
          <span class="contact__label">phone <span class="contact__optional">(optional)</span></span>
          <input type="tel" name="Phone" autocomplete="tel" />
        </label>
        <label class="contact__field">
          <span class="contact__label">what&rsquo;s this about?</span>
          <select name="Inquiry Type">
            <option value="Mural commission">mural commission</option>
            <option value="Print inquiry">print inquiry</option>
            <option value="Portrait commission">portrait commission</option>
            <option value="Press">press</option>
            <option value="Just saying hello">just saying hello</option>
          </select>
        </label>
      </div>

      <label class="contact__field">
        <span class="contact__label">message</span>
        <textarea
          name="Message"
          rows="6"
          required
          placeholder="tell me about your space, your idea, or what you&rsquo;re hoping to make."
        ></textarea>
      </label>

      <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="contact__honey" aria-hidden="true" />

      <div class="contact__submit-row">
        <button type="submit" class="contact__submit">
          <span>send</span>
          <span class="contact__submit-arrow" aria-hidden="true">›</span>
        </button>
      </div>
    </form>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--sp-12);
    border-top: 1px solid var(--color-line-soft);
    margin-top: var(--sp-8);
  }

  .contact__inner {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-6);
  }

  .contact__head {
    max-width: 520px;
  }

  .contact__title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-style: normal;
    line-height: 1;
    letter-spacing: -0.01em;
    color: var(--color-ink);
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin: 0 0 var(--sp-3);
  }

  .contact__lede {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--fs-md);
    line-height: 1.5;
    color: var(--color-ink-soft);
    margin: 0 0 var(--sp-5);
    max-width: 44ch;
  }

  .contact__direct {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .contact__direct li {
    display: grid;
    grid-template-columns: 100px 1fr;
    align-items: baseline;
    gap: var(--sp-2);
    font-family: var(--font-serif);
    font-size: var(--fs-base);
  }

  .contact__direct-label {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--fs-sm);
    color: var(--color-ink-mute);
  }

  .contact__direct a {
    color: var(--color-ink);
    border-bottom: 1px solid transparent;
    transition: border-color var(--duration-fast) var(--ease-out);
  }

  .contact__direct a:hover {
    border-bottom-color: var(--color-ink);
  }

  /* Form */
  .contact__form {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .contact__row {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--sp-3);
  }

  .contact__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .contact__label {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: var(--fs-sm);
    color: var(--color-ink-mute);
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
  }

  .contact__optional {
    font-style: italic;
    opacity: 0.7;
  }

  .contact__form input,
  .contact__form select,
  .contact__form textarea {
    border: 0;
    border-bottom: 1px solid var(--color-line);
    background: transparent;
    padding: 10px 0;
    font-family: var(--font-serif);
    font-size: var(--fs-base);
    color: var(--color-ink);
    transition: border-color var(--duration-fast) var(--ease-out);
    border-radius: 0;
  }

  .contact__form select {
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, var(--color-ink-mute) 50%),
                      linear-gradient(135deg, var(--color-ink-mute) 50%, transparent 50%);
    background-position: calc(100% - 14px) 50%, calc(100% - 8px) 50%;
    background-size: 6px 6px;
    background-repeat: no-repeat;
    padding-right: 24px;
    color-scheme: light;
  }

  .contact__form select option {
    background-color: var(--color-paper);
    color: var(--color-ink);
    padding: 8px;
  }

  .contact__form textarea {
    resize: vertical;
    min-height: 140px;
    padding: 10px 0;
    line-height: 1.6;
  }

  .contact__form input:focus,
  .contact__form select:focus,
  .contact__form textarea:focus {
    outline: 0;
    border-bottom-color: var(--color-ink);
  }

  .contact__honey {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    opacity: 0;
  }

  .contact__submit-row {
    display: flex;
    justify-content: flex-start;
    margin-top: var(--sp-3);
  }

  .contact__submit {
    display: inline-flex;
    align-items: baseline;
    gap: 0.3em;
    font-family: var(--font-serif);
    font-size: var(--fs-xl);
    color: var(--color-ink);
    padding: 0;
    transition: opacity var(--duration-fast) var(--ease-out);
  }

  .contact__submit-arrow {
    font-weight: 300;
    font-size: 0.9em;
    transition: transform var(--duration-base) var(--ease-out);
    display: inline-block;
  }

  .contact__submit:hover {
    opacity: 0.7;
  }

  .contact__submit:hover .contact__submit-arrow {
    transform: translateX(6px);
  }

  @media (min-width: 700px) {
    .contact__row {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 900px) {
    .contact__inner {
      grid-template-columns: 0.9fr 1.1fr;
      gap: var(--sp-12);
    }
  }
</style>
