---
import { Image } from "astro:assets";
import { galleries, slideshows, sections, type GalleryKey } from "../utils/galleries";

interface Props {
  sectionKey: GalleryKey;
}

const { sectionKey } = Astro.props;
const meta = sections.find((s) => s.key === sectionKey)!;

const fallback = galleries[sectionKey].slice(0, 1);
const slides = slideshows[sectionKey] ?? fallback;
const isCycling = slides.length > 1;
---

<a
  href={meta.href}
  class="section-preview reveal"
  id={sectionKey}
  aria-label={meta.title}
>
  <div
    class="section-preview__stage"
    data-cycle={isCycling ? "true" : "false"}
    data-count={slides.length}
  >
    {slides.map((item, i) => (
      <Image
        src={item.src}
        alt={item.alt}
        widths={[400, 600, 900, 1200]}
        sizes="(min-width: 1100px) 33vw, (min-width: 700px) 50vw, 95vw"
        quality={84}
        loading={i === 0 ? "eager" : "lazy"}
        class:list={[
          "section-preview__image",
          { "is-active": i === 0 },
        ]}
        data-slide-index={i}
      />
    ))}
  </div>

  <div class="section-preview__overlay">
    <h2 class="section-preview__title">
      {meta.title}
      <span class="section-preview__arrow" aria-hidden="true">›</span>
    </h2>
  </div>
</a>

<style>
  .section-preview {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    background: var(--color-paper);
  }

  .section-preview__stage {
    position: relative;
    width: 100%;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    background: var(--color-paper);
  }

  .section-preview__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    transition: opacity 900ms var(--ease-out), transform 1.2s var(--ease-out);
    will-change: opacity;
  }

  .section-preview__image.is-active {
    opacity: 1;
  }

  .section-preview:hover .section-preview__image.is-active {
    transform: scale(1.03);
  }

  .section-preview__overlay {
    position: absolute;
    inset: auto auto 0 0;
    padding: var(--sp-3);
    z-index: 2;
    pointer-events: none;
  }

  @media (min-width: 900px) {
    .section-preview__overlay {
      padding: var(--sp-4);
    }
  }

  .section-preview__title {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 400;
    color: var(--color-ink);
    font-size: clamp(1.75rem, 2.6vw, 2.5rem);
    line-height: 1;
    letter-spacing: -0.01em;
    display: inline-flex;
    align-items: baseline;
    gap: 0.25em;
    text-shadow:
      0 0 12px rgba(244, 243, 237, 0.7),
      0 0 28px rgba(244, 243, 237, 0.5);
  }

  .section-preview__arrow {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: 0.9em;
    line-height: 1;
    transition: transform var(--duration-base) var(--ease-out);
    display: inline-block;
  }

  .section-preview:hover .section-preview__arrow {
    transform: translateX(6px);
  }
</style>

<script>
  const stages = document.querySelectorAll<HTMLElement>(
    '.section-preview__stage[data-cycle="true"]'
  );

  const INTERVAL_MS = 2500;

  stages.forEach((stage) => {
    const slides = Array.from(
      stage.querySelectorAll<HTMLElement>(".section-preview__image")
    );
    if (slides.length < 2) return;

    let current = 0;
    let timer: number | null = null;

    const tick = () => {
      slides[current]?.classList.remove("is-active");
      current = (current + 1) % slides.length;
      slides[current]?.classList.add("is-active");
    };

    const start = () => {
      if (timer !== null) return;
      timer = window.setInterval(tick, INTERVAL_MS);
    };

    const stop = () => {
      if (timer === null) return;
      window.clearInterval(timer);
      timer = null;
    };

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) start();
          else stop();
        });
      },
      { threshold: 0.15 }
    );
    io.observe(stage);

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) stop();
      else if (stage.getBoundingClientRect().top < window.innerHeight) start();
    });
  });
</script>
