---
import { Image } from "astro:assets";
import aboutCover from "../assets/images/about-cover.png";
---

<section class="about-preview" id="about" aria-labelledby="about-title">
  <div class="container">
    <a href="/about/" class="about-preview__link reveal" aria-label="about">
      <div class="about-preview__stage">
        <Image
          src={aboutCover}
          alt="An abstract painting of waves of yellow, green and pink"
          widths={[720, 1100, 1440, 1920, 2400]}
          sizes="(min-width: 1100px) min(1600px, 90vw), 100vw"
          quality={86}
          loading="eager"
          class="about-preview__image"
        />
      </div>

      <div class="about-preview__overlay">
        <h2 id="about-title" class="about-preview__title">
          about
          <span class="about-preview__arrow" aria-hidden="true">›</span>
        </h2>
      </div>
    </a>
  </div>
</section>

<style>
  .about-preview {
    padding-block: var(--sp-4) 0;
  }

  .about-preview__link {
    position: relative;
    display: block;
    width: 100%;
    overflow: hidden;
    background: var(--color-paper);
  }

  /* Mobile: square-ish; desktop: cinematic wide hero */
  .about-preview__stage {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-paper);
  }

  @media (min-width: 900px) {
    .about-preview__stage {
      aspect-ratio: 16 / 9;
    }
  }

  @media (min-width: 1400px) {
    .about-preview__stage {
      aspect-ratio: 21 / 9;
    }
  }

  .about-preview__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transition: transform 1.2s var(--ease-out);
  }

  .about-preview__link:hover .about-preview__image {
    transform: scale(1.02);
  }

  .about-preview__overlay {
    position: absolute;
    inset: auto auto 0 0;
    padding: var(--sp-3) var(--sp-4);
    z-index: 2;
    pointer-events: none;
  }

  @media (min-width: 900px) {
    .about-preview__overlay {
      padding: var(--sp-5) var(--sp-6);
    }
  }

  .about-preview__title {
    margin: 0;
    font-family: var(--font-serif);
    font-weight: 400;
    color: var(--color-ink);
    font-size: clamp(2rem, 5vw, 4rem);
    line-height: 1;
    letter-spacing: -0.01em;
    display: inline-flex;
    align-items: baseline;
    gap: 0.25em;
    text-shadow:
      0 0 14px rgba(244, 243, 237, 0.7),
      0 0 32px rgba(244, 243, 237, 0.5);
  }

  .about-preview__arrow {
    font-weight: 300;
    font-size: 0.9em;
    line-height: 1;
    transition: transform var(--duration-base) var(--ease-out);
    display: inline-block;
  }

  .about-preview__link:hover .about-preview__arrow {
    transform: translateX(6px);
  }
</style>
